    "check:redirects": "node scripts/check-redirects.mjs",
    "generate-pdf": "node scripts/generate-pdf.js"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.8",
    "@astrojs/mdx": "^5.0.3",
    "@astrojs/react": "^5.0.2",
    "@astrojs/vercel": "^10.0.4",
    "@fontsource-variable/archivo": "^5.2.5",
    "@fontsource-variable/caveat": "^5.2.5",
    "@fontsource/alfa-slab-one": "^5.2.5",
    "@fontsource/ibm-plex-mono": "^5.2.5",
    "@keystatic/astro": "^6.0.0",
    "@keystatic/core": "^0.6.9",
    "@resvg/resvg-js": "^2.6.0",
    "astro": "^6.1.3",
    "astro-seo-schema": "^6.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "satori": "^0.10.11",
    "schema-dts": "^1.1.2",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.3.3"
