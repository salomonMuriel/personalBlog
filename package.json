    "@tailwindcss/vite": "^4.2.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/parser": "^8.58.0",
    "astro-eslint-parser": "^1.4.0",
    "eslint": "^9.39.4",
    "eslint-plugin-astro": "^1.6.0",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.2.4",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "puppeteer": "^23.0.0"
