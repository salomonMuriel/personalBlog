---
import EncabezadoSeccion from "@components/EncabezadoSeccion.astro";
import { getLocalizedCollection } from "@i18n/utils";
import { copia } from "@data/landing";
import type { Lang } from "@i18n/ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

/**
 * Los tres testimonios de direction-36 eran inventados y nunca se
 * publicaron. Esta sección se alimenta de la colección `testimonios` de
 * Keystatic y sencillamente no existe hasta que haya uno real y publicado.
 */
const c = copia(lang).voces;
const todos = await getLocalizedCollection(lang, "testimonios");
const voces = todos
  .filter(v => !v.data.draft)
  .sort((a, b) => a.data.order - b.data.order);
---

{
  voces.length > 0 && (
    <section id="voces" class="py-[clamp(3.2rem,7vw,5.6rem)]">
      <div class="hoja">
        <EncabezadoSeccion rotulo={c.rotulo} nota={c.nota} notaCh={42} />

        <h2 class="font-arch max-w-[18ch] text-[clamp(1.9rem,4.4vw,3.4rem)] font-extrabold leading-[1.03] tracking-[-.028em] [font-stretch:104%]">
          {c.titulo}
        </h2>

        <div class="mt-[clamp(1.8rem,3.6vw,2.8rem)] grid grid-cols-1 gap-[clamp(1rem,2.4vw,1.6rem)] lg:grid-cols-3">
          {voces.map(v => (
            <figure class="m-0 flex flex-col rounded border border-linea bg-campo p-5 sm:p-6">
              <span
                class="font-slab block select-none text-[2.4rem] leading-[.6] text-rojo"
                aria-hidden="true"
              >
                “
              </span>
              <blockquote class="mt-4 flex-1 text-[1rem] leading-[1.6]">
                {v.data.quote}
              </blockquote>
              <figcaption class="mt-5 flex items-center gap-3 border-t border-linea pt-4">
                <span
                  class="font-mono grid h-10 w-10 flex-none place-items-center rounded border border-linea bg-papel2 text-[12px] font-semibold text-gris"
                  aria-hidden="true"
                >
                  {v.data.initials}
                </span>
                <span class="font-mono text-[10.5px] uppercase leading-[1.6] tracking-[.13em]">
                  <b class="block font-semibold text-rojo2">{v.data.name}</b>
                  <span class="text-gris">{v.data.role}</span>
                </span>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )
}
