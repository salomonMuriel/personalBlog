---
import EncabezadoSeccion from "@components/EncabezadoSeccion.astro";
import GaleriaSistema from "@components/home/GaleriaSistema.astro";
import { copia, type Sistema } from "@data/landing";
import { pantallas } from "@data/pantallas";
import type { Lang } from "@i18n/ui";
import { imagenDe } from "@utils/pantallas";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = copia(lang).sistemas;

type Vista = { imagen: ImageMetadata; titulo: string; alt: string };
const items = (c.items as readonly Sistema[]).map(s => ({
  ...s,
  vistas: pantallas[s.clave].flatMap<Vista>(p => {
    const imagen = imagenDe(p.archivo);
    return imagen ? [{ imagen, titulo: p.titulo[lang], alt: p.alt[lang] }] : [];
  }),
}));
---

<section
  id="sistemas"
  class="border-y border-linea bg-papel2 py-[clamp(3.2rem,7vw,5.6rem)]"
>
  <div class="hoja">
    <EncabezadoSeccion rotulo={c.rotulo} nota={c.nota} notaCh={42} />

    <h2
      class="font-arch max-w-[22ch] text-[clamp(1.9rem,4.4vw,3.4rem)] font-extrabold leading-[1.03] tracking-[-.028em] [font-stretch:104%]"
    >
      {c.titulo}
    </h2>
    <p class="mt-4 max-w-[58ch] text-[1.05rem] leading-[1.55] text-gris">
      {c.bajada}
    </p>

    <div class="mt-[clamp(1.8rem,3.6vw,2.8rem)] border-t border-linea">
      {
        items.map((s, i) => (
          <article
            class:list={[
              "grid grid-cols-1 items-start gap-x-[clamp(1.4rem,3.5vw,3rem)] gap-y-5 border-b border-linea py-[clamp(1.6rem,3.4vw,2.6rem)]",
              i % 2 === 1
                ? "lg:grid-cols-[minmax(0,1.45fr)_minmax(0,.75fr)]"
                : "lg:grid-cols-[minmax(0,.75fr)_minmax(0,1.45fr)]",
            ]}
          >
            <div class:list={["lg:pt-1", i % 2 === 1 && "lg:order-2"]}>
              <p class="font-mono text-[11px] uppercase tracking-[.16em] text-rojo2">
                {s.sector}
              </p>
              <h3 class="font-arch mt-2 text-[clamp(1.4rem,2.8vw,1.95rem)] font-extrabold leading-[1.05] tracking-[-.028em]">
                {s.nombre}
              </h3>
              <p class="mt-3 max-w-[46ch] text-[1.02rem] leading-[1.55]">
                {s.que}
              </p>
              {s.reemplazo && (
                <p class="mt-3 max-w-[46ch] text-[.96rem] leading-[1.5] text-gris">
                  <b class="font-semibold text-tinta">{c.reemplazo}</b>{" "}
                  {s.reemplazo}
                </p>
              )}
            </div>
            {s.vistas.length > 0 && (
              <GaleriaSistema id={`galeria-${s.clave}`} vistas={s.vistas} />
            )}
          </article>
        ))
      }
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-galeria]").forEach(galeria => {
    const vistas = [...galeria.querySelectorAll<HTMLElement>("[data-vista]")];
    const botones = [
      ...galeria.querySelectorAll<HTMLButtonElement>("[data-mostrar]"),
    ];
    botones.forEach(boton => {
      boton.addEventListener("click", () => {
        const n = Number(boton.dataset.mostrar);
        vistas.forEach((v, i) => (v.hidden = i !== n));
        botones.forEach((b, i) =>
          b.setAttribute("aria-pressed", String(i === n))
        );
      });
    });
  });
</script>
