---
import { Image } from "astro:assets";
import EncabezadoSeccion from "@components/EncabezadoSeccion.astro";
import { copia, type Sistema } from "@data/landing";
import type { Lang } from "@i18n/ui";
import { pantallaDe } from "@utils/pantallas";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = copia(lang).sistemas;
const [destacado, ...resto] = c.items as readonly Sistema[];
const imagenDestacada = pantallaDe(destacado.clave);

const mat = "rounded border border-linea bg-campo p-[7px]";
const foto = "h-auto w-full rounded-[1px]";
---

<section
  id="sistemas"
  class="border-y border-linea bg-papel2 py-[clamp(3.2rem,7vw,5.6rem)]"
>
  <div class="hoja">
    <EncabezadoSeccion rotulo={c.rotulo} nota={c.nota} notaCh={42} />

    <h2
      class="font-arch max-w-[22ch] text-[clamp(1.9rem,4.4vw,3.4rem)] font-extrabold leading-[1.03] tracking-[-.028em] [font-stretch:104%]"
    >
      {c.titulo}
    </h2>
    <p class="mt-4 max-w-[58ch] text-[1.05rem] leading-[1.55] text-gris">
      {c.bajada}
    </p>

    <article
      class="mt-[clamp(1.8rem,3.6vw,2.8rem)] grid grid-cols-1 items-center gap-[clamp(1.4rem,3.5vw,3rem)] lg:grid-cols-[minmax(0,.8fr)_minmax(0,1.4fr)]"
    >
      <div>
        <p class="font-mono text-[11px] uppercase tracking-[.16em] text-rojo2">
          {destacado.sector}
        </p>
        <h3
          class="font-arch mt-2 text-[clamp(1.5rem,3vw,2.1rem)] font-extrabold leading-[1.05] tracking-[-.028em]"
        >
          {destacado.nombre}
        </h3>
        <p class="mt-3 max-w-[46ch] text-[1.04rem] leading-[1.55]">
          {destacado.que}
        </p>
        {
          destacado.reemplazo && (
            <p class="mt-3 max-w-[46ch] text-[.96rem] leading-[1.5] text-gris">
              <b class="font-semibold text-tinta">{c.reemplazo}</b>{" "}
              {destacado.reemplazo}
            </p>
          )
        }
      </div>
      {
        imagenDestacada && (
          <div
            class={`${mat} shadow-[0_1px_0_rgba(22,23,26,.05),0_16px_36px_-28px_rgba(22,23,26,.55)]`}
          >
            <Image
              src={imagenDestacada}
              widths={[640, 960, 1440]}
              sizes="(min-width:1024px) 58vw, 92vw"
              loading="lazy"
              alt={destacado.alt}
              class={foto}
            />
          </div>
        )
      }
    </article>

    <div class="mt-[clamp(2rem,4vw,3rem)] border-t border-linea">
      {
        resto.map(s => {
          const imagen = pantallaDe(s.clave);
          return (
            <article class="grid grid-cols-1 gap-x-8 gap-y-3 border-b border-linea py-[clamp(1.3rem,2.6vw,2rem)] md:grid-cols-[9.5rem_minmax(0,1fr)_minmax(0,.75fr)] md:items-start">
              <div class="font-mono text-[11px] uppercase leading-[1.7] tracking-[.14em] text-gris">
                <div class="text-rojo2">{s.sector}</div>
              </div>
              <div>
                <h3 class="font-arch text-[clamp(1.2rem,2.4vw,1.55rem)] font-bold leading-[1.12] tracking-[-.028em]">
                  {s.nombre}
                </h3>
                <p class="mt-2 max-w-[48ch] text-[1rem] leading-[1.55]">
                  {s.que}
                </p>
                {s.reemplazo && (
                  <p class="mt-2 max-w-[48ch] text-[.94rem] leading-[1.5] text-gris">
                    <b class="font-semibold text-tinta">{c.reemplazo}</b>{" "}
                    {s.reemplazo}
                  </p>
                )}
              </div>
              {imagen && (
                <div
                  class:list={[
                    mat,
                    imagen.height > imagen.width && "w-full max-w-[170px]",
                  ]}
                >
                  <Image
                    src={imagen}
                    widths={[480, 720, 960]}
                    sizes="(min-width:768px) 36vw, 92vw"
                    loading="lazy"
                    alt={s.alt}
                    class={foto}
                  />
                </div>
              )}
            </article>
          );
        })
      }
    </div>
  </div>
</section>
