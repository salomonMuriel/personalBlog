---
import { Image } from "astro:assets";
import EncabezadoSeccion from "@components/EncabezadoSeccion.astro";
import { copia, type Columna } from "@data/landing";
import type { Lang } from "@i18n/ui";
import { ilustraciones } from "@utils/ilustraciones";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = copia(lang).entrega;
const columnas = c.columnas as readonly Columna[];
---

<section id="entrega" class="py-[clamp(3.2rem,7vw,5.6rem)]">
  <div class="hoja">
    <EncabezadoSeccion rotulo={c.rotulo} nota={c.nota} notaCh={40} />

    <h2
      class="font-arch max-w-[22ch] text-[clamp(1.9rem,4.4vw,3.4rem)] font-extrabold leading-[1.03] tracking-[-.028em] [font-stretch:104%]"
    >
      {c.titulo}
    </h2>
    {
      c.bajada && (
        <p class="mt-4 max-w-[58ch] text-[1.05rem] leading-[1.55] text-gris">
          {c.bajada}
        </p>
      )
    }

    <div
      class="mt-[clamp(1.6rem,3.4vw,2.4rem)] rounded border border-linea bg-campo p-[7px]"
    >
      <Image
        src={ilustraciones.llaves}
        widths={[640, 1280, 2016]}
        sizes="(min-width:1320px) 1200px, 94vw"
        loading="lazy"
        alt={c.alt}
        class="aspect-[3/1] h-auto w-full rounded-[1px] object-cover"
      />
    </div>

    <div
      class="mt-[clamp(1.6rem,3.4vw,2.4rem)] grid grid-cols-1 gap-x-[clamp(1.2rem,2.6vw,2rem)] gap-y-6 border-t-[2.5px] border-tinta pt-5 sm:grid-cols-2 lg:grid-cols-4"
    >
      {
        columnas.map((col, i) => (
          <div>
            <p class="font-mono text-[11px] font-semibold uppercase tracking-[.18em] text-rojo2">
              {String(i + 1).padStart(2, "0")}
            </p>
            <h3 class="font-arch mt-1.5 text-[1.15rem] font-bold leading-tight tracking-[-.02em]">
              {col.t}
            </h3>
            <p class="mt-2 text-[.98rem] leading-[1.5] text-gris">{col.d}</p>
          </div>
        ))
      }
    </div>

    <p
      class="mt-[clamp(1.6rem,3.4vw,2.4rem)] max-w-[80ch] border-t border-linea pt-4 text-[.98rem] leading-[1.6] text-gris"
      set:html={c.noIncluye}
    />
  </div>
</section>
