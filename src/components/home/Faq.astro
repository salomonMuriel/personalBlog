---
import EncabezadoSeccion from "@components/EncabezadoSeccion.astro";
import type { Pregunta } from "@utils/jsonld";
import type { Lang } from "@i18n/ui";

interface Props {
  lang: Lang;
  preguntas: Pregunta[];
}
const { lang, preguntas } = Astro.props;
const es = lang === "es";
---

<section id="preguntas" class="py-[clamp(3.2rem,7vw,5.6rem)]">
  <div class="hoja">
    <EncabezadoSeccion
      rotulo={es ? "Consultas frecuentes" : "Frequently asked"}
      nota={es
        ? "Las mismas ocho, en el mismo orden, casi siempre."
        : "The same eight, in the same order, nearly always."}
      notaCh={40}
    />

    <div
      class="grid grid-cols-1 items-start gap-[clamp(1.5rem,4vw,3.5rem)] lg:grid-cols-[minmax(0,.55fr)_minmax(0,1fr)]"
    >
      <div>
        <h2
          class="font-arch max-w-[14ch] text-[clamp(1.9rem,4.4vw,3.2rem)] font-extrabold leading-[1.03] tracking-[-.028em] [font-stretch:104%]"
        >
          {es ? "Lo que siempre me preguntan" : "What people always ask me"}
        </h2>
        <p class="mt-5 max-w-[38ch] text-[1.02rem] leading-[1.6] text-gris">
          {
            es
              ? "Si su pregunta no está acá, escríbame y se la contesto yo."
              : "If your question isn't here, write to me and I'll answer it myself."
          }
        </p>
      </div>

      <div>
        {
          preguntas.map((q, i) => (
            <details
              class:list={[
                "border-t border-linea",
                i === preguntas.length - 1 && "border-b",
              ]}
            >
              <summary class="flex items-start gap-4 py-[1.05rem] pr-2">
                <span class="font-arch flex-1 text-[clamp(1rem,1.7vw,1.14rem)] font-bold leading-[1.3] tracking-[-.015em]">
                  {q.p}
                </span>
                <span
                  class="cruz mt-[3px] flex-none text-rojo2"
                  aria-hidden="true"
                >
                  <svg class="h-[18px] w-[18px]">
                    <use href="#i-mas" />
                  </svg>
                </span>
              </summary>
              <p class="resp max-w-medida pb-5 pr-6 text-[1rem] leading-[1.65] text-gris">
                {q.r}
              </p>
            </details>
          ))
        }
      </div>
    </div>
  </div>
</section>
