---
import { Image } from "astro:assets";
import { wa } from "@config";
import { copia } from "@data/landing";
import type { Lang } from "@i18n/ui";
import fotoSalo from "@assets/site/fotoSalo.jpeg";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = copia(lang).hero;
---

<section class="pb-[clamp(2rem,4vw,3.4rem)] pt-[clamp(1.5rem,3.2vw,2.4rem)]">
  <div class="hoja">
    <div
      class="grid grid-cols-1 items-start gap-x-[clamp(1.8rem,4vw,3.5rem)] gap-y-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,300px)]"
    >
      <div class="min-w-0">
        <h1>
          <span
            class="font-arch block text-[clamp(2.9rem,9.2vw,5.8rem)] font-black uppercase leading-[.84] tracking-[.005em] [font-stretch:62%] [font-variation-settings:'wdth'_62,'wght'_900]"
            >{c.linea1}</span
          >
          <span
            class="font-slab pintado mt-3 block text-[clamp(1.7rem,5.3vw,3.35rem)] uppercase leading-[.98] tracking-[-.012em] sm:mt-4"
            >{c.linea2}</span
          >
        </h1>

        <p
          class="font-pen mt-4 -rotate-[1.4deg] text-[clamp(1.2rem,3.2vw,1.6rem)] leading-[1.2] text-rojo2 [transform-origin:left]"
        >
          {c.manuscrita}
        </p>

        <p
          class="mt-5 max-w-[50ch] text-[clamp(1.06rem,1.7vw,1.26rem)] leading-[1.45]"
        >
          {c.bajada}
        </p>

        <!-- entrada de diccionario -->
        <div
          class="mt-5 max-w-[40rem] rounded border border-linea bg-campo shadow-[0_1px_0_rgba(22,23,26,.05),0_16px_36px_-28px_rgba(22,23,26,.55)]"
        >
          <div class="px-5 pb-4 pt-4 sm:px-6">
            <p
              class="font-slab text-[clamp(1.35rem,4.2vw,1.9rem)] leading-none"
            >
              {c.dicc.palabra}
            </p>
            <p
              class="font-mono mt-2 text-[10.5px] uppercase tracking-[.2em] text-gris"
            >
              {c.dicc.categoria}
            </p>
            <ol
              class="mt-3.5 max-w-[46ch] space-y-2.5 text-[.98rem] leading-[1.45]"
            >
              {
                c.dicc.acepciones.map((a, i) => (
                  <li class="flex gap-3">
                    <span class="font-slab flex-none text-[.82rem] leading-[1.75] text-rojo2">
                      {i + 1}.
                    </span>
                    <span set:html={a} />
                  </li>
                ))
              }
            </ol>
          </div>
        </div>

        <div class="mt-6 flex flex-wrap gap-3">
          <a
            href={wa(c.ctaPrincipalWa)}
            target="_blank"
            rel="noopener"
            data-origen="hero"
            class="inline-flex items-center gap-2.5 rounded bg-rojo2 px-5 py-3.5 text-[.97rem] font-bold text-white transition-[background-color,transform] hover:bg-tinta active:translate-y-px"
          >
            {c.ctaPrincipal}<svg
              class="h-[18px] w-[18px] opacity-80"
              aria-hidden="true"><use href="#i-arw"></use></svg
            >
          </a>
          <a
            href="#cajitas"
            class="inline-flex items-center gap-2.5 rounded border-[1.5px] border-linea2 px-5 py-3.5 text-[.97rem] font-bold transition-[border-color,background-color,transform] hover:border-tinta hover:bg-papel2 active:translate-y-px"
          >
            {c.ctaSecundario}<svg
              class="h-[18px] w-[18px] opacity-70"
              aria-hidden="true"><use href="#i-abajo"></use></svg
            >
          </a>
        </div>

        <p
          class="font-mono mt-4 text-[10.5px] uppercase leading-[1.9] tracking-[.13em] text-gris"
        >
          {c.especificacion}
        </p>
      </div>

      <!-- el que atiende -->
      <aside
        class="relative max-w-[230px] sm:max-w-[260px] lg:mt-2 lg:max-w-none"
      >
        <span
          class="absolute -left-[11px] bottom-3 top-3 hidden w-[3px] bg-rojo lg:block"
          aria-hidden="true"></span>
        <div class="rounded border border-linea bg-campo p-[9px]">
          <Image
            src={fotoSalo}
            widths={[260, 520, 800]}
            sizes="(min-width:1024px) 300px, 260px"
            alt={c.fichaAlt}
            class="aspect-[4/5] h-auto w-full rounded-[1px] object-cover object-[50%_16%] [filter:grayscale(.14)_contrast(1.05)]"
            loading="eager"
            fetchpriority="high"
          />
        </div>
        <dl class="font-mono mt-3 text-[10.5px] uppercase tracking-[.13em]">
          {
            c.ficha.map(([k, v, rojo], i) => (
              <div
                class:list={[
                  "flex justify-between gap-3 py-[7px]",
                  i < c.ficha.length - 1 && "border-b border-linea",
                ]}
              >
                <dt class="text-gris">{k}</dt>
                <dd class:list={["font-medium", rojo && "text-rojo2"]}>{v}</dd>
              </div>
            ))
          }
        </dl>
        <p class="mt-4 text-[14px] leading-[1.5] text-gris">{c.fichaPie}</p>
      </aside>
    </div>
  </div>
</section>
