---
import { Image } from "astro:assets";
import { copia } from "@data/landing";
import ParCta from "@components/home/ParCta.astro";
import type { Lang } from "@i18n/ui";
import fotoSalo from "@assets/site/fotoSalo.jpeg";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = copia(lang).hero;
---

<section class="pb-[clamp(1.6rem,3vw,2.4rem)] pt-[clamp(1rem,2.4vw,1.8rem)]">
  <div class="hoja">
    <div
      class="grid grid-cols-1 items-start gap-x-[clamp(1.8rem,4vw,3.5rem)] gap-y-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,280px)]"
    >
      <div class="min-w-0">
        <h1>
          <span
            class="font-arch block text-[clamp(2.9rem,9.2vw,5.8rem)] font-black uppercase leading-[.84] tracking-[.005em] [font-stretch:62%] [font-variation-settings:'wdth'_62,'wght'_900]"
            >{c.linea1}</span
          >
          <span
            class="font-slab pintado mt-3 block text-[clamp(1.7rem,5.3vw,3.35rem)] uppercase leading-[.98] tracking-[-.012em] sm:mt-4"
            >{c.linea2}</span
          >
        </h1>

        <p
          class="font-pen mt-3 -rotate-[1.4deg] text-[clamp(1.2rem,3.2vw,1.6rem)] leading-[1.2] text-rojo2 [transform-origin:left]"
        >
          {c.manuscrita}
        </p>

        <p
          class="mt-4 max-w-[50ch] text-[clamp(1.04rem,1.6vw,1.22rem)] leading-[1.45]"
        >
          {c.bajada}
        </p>

        <div data-pliegue>
          <ParCta lang={lang} origen="hero" nota class="mt-5" />
        </div>

        <div
          class="mt-10 max-w-[40rem] lg:mt-6 rounded border border-linea bg-campo shadow-[0_1px_0_rgba(22,23,26,.05),0_16px_36px_-28px_rgba(22,23,26,.55)]"
        >
          <div class="px-5 pb-4 pt-4 sm:px-6">
            <p
              class="font-slab text-[clamp(1.35rem,4.2vw,1.9rem)] leading-none"
            >
              {c.dicc.palabra}
            </p>
            <p
              class="font-mono mt-2 text-[10.5px] uppercase tracking-[.2em] text-gris"
            >
              {c.dicc.categoria}
            </p>
            <ol
              class="mt-3.5 max-w-[46ch] space-y-2.5 text-[.98rem] leading-[1.45]"
            >
              {
                c.dicc.acepciones.map((a, i) => (
                  <li class="flex gap-3">
                    <span class="font-slab flex-none text-[.82rem] leading-[1.75] text-rojo2">
                      {i + 1}.
                    </span>
                    <span set:html={a} />
                  </li>
                ))
              }
            </ol>
          </div>
        </div>
      </div>

      <aside
        class="relative max-w-[230px] sm:max-w-[260px] lg:mt-2 lg:max-w-none"
      >
        <span
          class="absolute -left-[11px] bottom-3 top-3 hidden w-[3px] bg-rojo lg:block"
          aria-hidden="true"></span>
        <div class="rounded border border-linea bg-campo p-[9px]">
          <Image
            src={fotoSalo}
            widths={[260, 520, 800]}
            sizes="(min-width:1024px) 280px, 260px"
            alt={c.fichaAlt}
            class="aspect-[4/5] h-auto w-full rounded-[1px] object-cover object-[50%_16%] [filter:grayscale(.14)_contrast(1.05)]"
            loading="eager"
            fetchpriority="high"
          />
        </div>
        <p
          class="font-mono mt-3 border-b border-tinta pb-2 text-[11px] font-semibold uppercase leading-[1.6] tracking-[.13em]"
        >
          {c.especificacion}
        </p>
        <dl class="font-mono text-[10.5px] uppercase tracking-[.13em]">
          {
            c.ficha.map(([k, v, rojo], i) => (
              <div
                class:list={[
                  "flex justify-between gap-3 py-[7px]",
                  i < c.ficha.length - 1 && "border-b border-linea",
                ]}
              >
                <dt class="text-gris">{k}</dt>
                <dd class:list={["font-medium", rojo && "text-rojo2"]}>{v}</dd>
              </div>
            ))
          }
        </dl>
      </aside>
    </div>
  </div>
</section>
