---
interface Props {
  etiqueta: string;
}
const { etiqueta } = Astro.props;
---

<button
  type="button"
  class="pausa"
  data-a2-pausa
  aria-pressed="false"
  aria-label={etiqueta}
>
  <svg viewBox="0 0 16 16" aria-hidden="true">
    <path class="i-pausa" d="M5.5 4v8M10.5 4v8"></path>
    <path class="i-play" d="M5.5 3.8 12 8l-6.5 4.2z"></path>
  </svg>
</button>

<style>
  /* Phones: over the window's corner. Desktop: on the phone's lower corner. */
  .pausa {
    position: absolute;
    z-index: 3;
    top: 10px;
    right: 14px;
    display: none;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(16, 17, 21, 0.86);
    color: var(--papel);
    box-shadow: 0 0 0 1px rgba(236, 234, 228, 0.45);
    transition: background-color 0.14s;
  }
  /* Shown only once the rotation script runs. */
  :global([data-vivo]) > .pausa {
    display: grid;
  }
  .pausa::before {
    content: "";
    position: absolute;
    inset: -5px;
  }
  .pausa:hover {
    background: var(--rojo2);
  }
  .pausa:focus-visible {
    outline-color: var(--papel);
  }
  .pausa svg {
    width: 14px;
    height: 14px;
    fill: currentColor;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .i-pausa {
    fill: none;
  }
  .i-play,
  .pausa[aria-pressed="true"] .i-pausa {
    display: none;
  }
  .pausa[aria-pressed="true"] .i-play {
    display: block;
  }

  @media (min-width: 1024px) {
    .pausa {
      top: calc(var(--img-h) * 0.45 - 18px);
      right: auto;
      left: calc(var(--foto-w) * 0.1 - 18px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pausa {
      transition: none;
    }
  }
</style>
