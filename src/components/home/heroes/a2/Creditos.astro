---
interface Props {
  palabra: string;
  categoria: string;
  acepciones: readonly string[];
  marcada: string;
  tachada: string;
  correccion: string;
}
const { palabra, categoria, acepciones, marcada, tachada, correccion } =
  Astro.props;
const [primera, segunda, ultima] = acepciones;

const ultimaMarcada = ultima.replace(
  marcada,
  `<mark class="marca">${marcada}</mark>`
);
---

<div class="creditos">
  <p class="corrido">
    <span class="voz font-slab">{palabra}</span>
    <span class="cat">{categoria}</span>
    <span data-mide="acepcion-1"
      ><span class="n">1.</span> <span set:html={primera} /></span
    >
    <span class="hidden md:inline"
      ><span class="n">2.</span> <span set:html={segunda} /></span
    >
  </p>
  <p class="remate" data-mide="remate">
    <span class="n font-slab">3.</span>
    <span set:html={ultimaMarcada} />
  </p>
</div>

<style>
  .creditos {
    position: relative;
    z-index: 2;
    order: 4;
    margin-top: 16px;
  }
  .corrido {
    font-size: 13px;
    line-height: 1.38;
    letter-spacing: 0.035em;
    text-transform: uppercase;
    font-variation-settings:
      "wdth" 70,
      "wght" 460;
    color: var(--txt);
  }
  .corrido :global(b) {
    font-variation-settings:
      "wdth" 70,
      "wght" 800;
    color: var(--fg);
  }
  .voz {
    text-transform: none;
    letter-spacing: 0;
    font-size: 1.36em;
    line-height: 1;
    color: var(--fg);
  }
  .cat {
    text-transform: none;
    color: var(--nota);
    margin-right: 0.35em;
  }
  .n {
    color: var(--rojo3);
    font-variation-settings:
      "wdth" 70,
      "wght" 800;
  }
  .remate {
    margin-top: 12px;
    font-size: 19px;
    line-height: 1.2;
    text-transform: uppercase;
    letter-spacing: 0.012em;
    font-variation-settings:
      "wdth" 66,
      "wght" 820;
    color: var(--papel);
  }
  .remate .n {
    font-variation-settings: normal;
    margin-right: 0.12em;
  }

  /* ── the hand on the last sense ── */
  .remate :global(.marca) {
    position: relative;
    z-index: 0;
    padding: 0 0.12em;
    margin: 0 -0.02em;
    background: none;
    color: var(--papel);
  }
  .remate :global(.marca)::before {
    content: "";
    position: absolute;
    z-index: -1;
    inset: -0.02em -0.06em -0.04em -0.08em;
    background: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 200 40' preserveAspectRatio='none'><path fill='%23b3251d' d='M4 6.5C38 3.8 92 4.6 140 3.2c22-.6 40 .2 56 1.4 2.6 6.5 1.6 18.8 2.8 28.6-28 2.8-84 4.1-150 3.6-16-.1-31-.9-46-1.9C1.2 25 .6 15 4 6.5Z'/></svg>")
      center / 100% 100% no-repeat;
    rotate: -1.2deg;
    animation: pintar 0.42s cubic-bezier(0.3, 0.7, 0.2, 1) 0.3s both;
  }
  .remate :global(.tachon) {
    position: relative;
    display: inline-block;
  }
  .remate :global(.tachon s) {
    position: relative;
    text-decoration: none;
    color: var(--txt);
  }
  .remate :global(.tachon s)::after {
    content: "";
    position: absolute;
    left: -4%;
    right: -3%;
    top: 30%;
    height: 0.36em;
    background: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 300 20' preserveAspectRatio='none'><path fill='none' stroke='%23ea4b3e' stroke-width='5.5' stroke-linecap='round' d='M3 13.5C52 11.6 96 11.4 150 10c48-1.4 98-2.6 146-3.6'/></svg>")
      center / 100% 100% no-repeat;
    animation: pintar 0.3s ease-out 0.75s both;
  }
  .remate :global(.correccion) {
    display: inline-block;
    margin-left: 0.22em;
    font-size: 1.45em;
    line-height: 0.6;
    text-transform: none;
    letter-spacing: 0;
    font-variation-settings: "wght" 700;
    color: var(--rojo3);
    white-space: nowrap;
    rotate: -7deg;
    translate: 0 -0.12em;
    animation: pintar 0.35s ease-out 1s both;
  }

  /* A left-to-right wipe, like a pen moving. */
  @keyframes pintar {
    from {
      clip-path: inset(-1em 100% -1em -1em);
    }
    to {
      clip-path: inset(-1em -1em -1em -1em);
    }
  }

  @media (min-width: 768px) {
    .corrido {
      font-size: 14.5px;
    }
    .remate {
      font-size: 26px;
    }
  }

  /* desktop: the billing block across the foot of the poster */
  @media (min-width: 1024px) {
    .creditos {
      order: 5;
      margin-top: auto;
      padding-top: 28px;
      text-align: center;
    }
    .corrido {
      max-width: 1120px;
      margin-inline: auto;
      font-size: clamp(13.5px, 1vw, 15px);
      text-wrap: balance;
    }
    .remate {
      margin-top: clamp(14px, 2.4svh, 24px);
      font-size: min(2.5vw, 4.4svh, 38px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .remate :global(.marca)::before,
    .remate :global(.tachon s)::after,
    .remate :global(.correccion) {
      animation: none;
    }
  }
</style>
