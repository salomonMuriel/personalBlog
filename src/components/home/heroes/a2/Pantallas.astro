---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { pantallas } from "@data/pantallas";
import { heroA2 } from "@data/heroes/a2";
import type { Lang } from "@i18n/ui";
import auraHoy from "@assets/heroes/a2/aura-hoy.webp";
import auraWhatsapp from "@assets/heroes/a2/aura-whatsapp.webp";
import guiaTablero from "@assets/heroes/a2/guiacolegio-tablero.webp";
import guiaAgenda from "@assets/heroes/a2/guiacolegio-agenda.webp";
import constoRevisar from "@assets/heroes/a2/consto-revisar.webp";
import memoplanSemana from "@assets/heroes/a2/memoplan-semana.webp";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const todas = Object.values(pantallas).flat();
const altDe = (archivo: string) => {
  const pantalla = todas.find(p => p.archivo === archivo);
  if (!pantalla) throw new Error(`HeroA2: missing screen ${archivo}`);
  return pantalla.alt[lang];
};

type Pieza = { src: ImageMetadata; alt: string };
// One set per system: a phone or narrow panel on the left, a window on the right.
const sets: { izquierda: Pieza; derecha: Pieza }[] = [
  {
    izquierda: { src: auraWhatsapp, alt: altDe("aura-whatsapp-390") },
    derecha: { src: auraHoy, alt: altDe("aura-hoy-1440") },
  },
  {
    izquierda: { src: guiaAgenda, alt: heroA2.altAgenda },
    derecha: { src: guiaTablero, alt: altDe("guiacolegio-tablero-1440") },
  },
  {
    izquierda: { src: memoplanSemana, alt: altDe("memoplan-semana-390") },
    derecha: { src: constoRevisar, alt: altDe("consto-revisar-1440") },
  },
];
const lados = [
  {
    clave: "izquierda",
    widths: [150, 300],
    sizes: "(min-width: 1024px) 150px, 90px",
  },
  {
    clave: "derecha",
    widths: [400, 760],
    sizes: "(min-width: 1024px) 380px, 230px",
  },
] as const;
---

{
  lados.map(lado => (
    <div class={`pantalla pantalla--${lado.clave}`}>
      {sets.map((set, i) => (
        <Image
          src={set[lado.clave].src}
          widths={[...lado.widths]}
          sizes={lado.sizes}
          alt={set[lado.clave].alt}
          loading={i === 0 ? "eager" : "lazy"}
          data-set={i}
          data-activa={i === 0 ? "" : undefined}
        />
      ))}
    </div>
  ))
}

<style>
  /* Lit panels in a dark room, placed in the portrait's own coordinates. */
  .pantalla {
    position: absolute;
    z-index: 0;
    overflow: hidden;
    background: #0c0d10;
  }
  .pantalla::after {
    content: "";
    position: absolute;
    z-index: 2;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px rgba(236, 234, 228, 0.14);
    background: linear-gradient(
      to bottom,
      rgba(16, 17, 21, 0) 30%,
      rgba(16, 17, 21, 0.72)
    );
  }
  .pantalla--izquierda {
    left: 10%;
    top: 34%;
    width: 20%;
    aspect-ratio: 300 / 566;
    border-radius: 9px;
  }
  .pantalla--derecha {
    left: 56%;
    top: 33%;
    width: 52%;
    aspect-ratio: 16 / 10;
    border-radius: 4px;
  }
  .pantalla :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 0 0;
    opacity: 0;
    filter: grayscale(0.65) brightness(0.84);
    transition: opacity 0.9s cubic-bezier(0.65, 0, 0.35, 1);
  }
  .pantalla--derecha :global(img) {
    transition-delay: 0.15s;
  }
  .pantalla :global(img[data-activa]) {
    z-index: 1;
    opacity: 1;
  }
  /* The leaving screen stays lit under the arriving one, so the swap never dims. */
  .pantalla :global(img[data-saliendo]) {
    opacity: 1;
    transition: none;
  }
  .pantalla :global(img:not([data-set="0"]):not([data-listo])) {
    display: none;
  }

  @media (min-width: 1024px) {
    .pantalla--izquierda {
      border-radius: 12px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pantalla :global(img) {
      transition: none;
    }
  }
</style>
