---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { wa } from "@config";
import { copia } from "@data/landing";
import { pantallas } from "@data/pantallas";
import { heroG } from "@data/heroes/g";
import { routes, type Lang } from "@i18n/ui";
import fotoSaloAlta from "@assets/site/fotoSaloAlta.jpg";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = copia(lang);
const g = heroG[lang];

const capturas = import.meta.glob<ImageMetadata>(
  "/src/assets/sistemas/*.webp",
  {
    eager: true,
    import: "default",
  }
);
const todas = Object.values(pantallas).flat();

// x, y, w in % of the collage (desktop); m = the same for the phone strip.
// recorte = [left, top, width, height] of the source, as fractions.
type Pieza = {
  archivo: string;
  tipo: "ventana" | "celular" | "recorte";
  x: number;
  y: number;
  w: number;
  z: number;
  recorte?: [number, number, number, number];
  fundido?: boolean;
  m?: [number, number, number];
};

// prettier-ignore
const sets: Pieza[][] = [
  [
    { archivo: "aura-hoy-1440", tipo: "ventana", x: 0, y: 1, w: 80, z: 1, m: [0, 14, 50] },
    { archivo: "aura-hoy-1440", tipo: "recorte", x: 63, y: 21, w: 37, z: 3, recorte: [0.776, 0.215, 0.208, 0.36] },
    { archivo: "aura-whatsapp-390", tipo: "celular", x: 75, y: 58, w: 25, z: 3, m: [78, 3, 22] },
    { archivo: "aura-movimientos-1440", tipo: "recorte", x: 0, y: 50, w: 34, z: 3, recorte: [0.208, 0.21, 0.19, 0.23] },
  ],
  [
    { archivo: "guiacolegio-tablero-1440", tipo: "ventana", x: 20, y: 1, w: 80, z: 1 },
    { archivo: "guiacolegio-analitica-1440", tipo: "recorte", x: 0, y: 27, w: 50, z: 3, recorte: [0.585, 0.445, 0.395, 0.3] },
    { archivo: "guiacolegio-hoy-1440", tipo: "recorte", x: 66, y: 60, w: 34, z: 3, recorte: [0.765, 0.505, 0.21, 0.25] },
    { archivo: "guiacolegio-hoy-1440", tipo: "recorte", x: 0, y: 70, w: 36, z: 3, recorte: [0.178, 0.505, 0.2, 0.17] },
  ],
  [
    { archivo: "consto-revisar-1440", tipo: "ventana", x: 0, y: 1, w: 80, z: 1 },
    { archivo: "memoplan-semana-390", tipo: "celular", x: 72, y: 22, w: 28, z: 3 },
    { archivo: "consto-revisar-1440", tipo: "recorte", x: 0, y: 52, w: 40, z: 3, recorte: [0.515, 0, 0.245, 0.07] },
    { archivo: "consto-revisar-1440", tipo: "recorte", x: 0, y: 75, w: 40, z: 3, recorte: [0.25, 0.555, 0.26, 0.2], fundido: true },
  ],
];

function pantalla(archivo: string) {
  const datos = todas.find(p => p.archivo === archivo);
  const src = capturas[`/src/assets/sistemas/${archivo}.webp`];
  if (!datos || !src) throw new Error(`HeroG: missing screen ${archivo}`);
  return { src, alt: datos.alt[lang], titulo: datos.titulo[lang] };
}

function estilo(p: Pieza) {
  const [cx, cy, cw, ch] = p.recorte ?? [0, 0, 1, 1];
  const fuente = pantalla(p.archivo).src;
  const proporcion =
    p.tipo === "ventana"
      ? "16 / 11"
      : p.tipo === "celular"
        ? "9 / 17"
        : `${(cw * fuente.width).toFixed(0)} / ${(ch * fuente.height).toFixed(0)}`;
  const [mx, my, mw] = p.m ?? [0, 0, 0];
  return `--x:${p.x}%;--y:${p.y}%;--w:${p.w}%;--z:${p.z};--mx:${mx}%;--my:${my}%;--mw:${mw}%;--cx:${cx};--cy:${cy};--cw:${cw};aspect-ratio:${proporcion}`;
}

const anchos = {
  ventana: [480, 800],
  celular: [220, 420],
  recorte: [900, 1400],
};
const tamanos = {
  ventana: "(min-width: 768px) 380px, 170px",
  celular: "(min-width: 768px) 130px, 80px",
  recorte: "(min-width: 768px) 820px, 400px",
};

const [cabeza, ...resto] = c.hero.bajada.split(":");
const acepciones = c.hero.dicc.acepciones.map(a => {
  const corte = a.indexOf(":");
  return corte < 0
    ? ["", a]
    : [a.slice(0, corte + 1), a.slice(corte + 1).trim()];
});
---

<section class="hg" aria-labelledby="hg-h1">
  <div class="hoja">
    <div class="hg-grid">
      <div class="hg-texto">
        <h1 id="hg-h1" data-mide="h1" class="hg-h1">
          <span class="hg-l1 font-arch">{c.hero.linea1}</span>
          <span class="hg-l2 font-slab pintado">{c.hero.linea2}</span>
        </h1>
        <p class="hg-icp" data-mide="icp">{g.icp}</p>
      </div>

      <div class="hg-dicc">
        <p class="hg-palabra">
          <span class="font-slab">{c.hero.dicc.palabra}</span>
          <span class="font-mono hg-cat">{c.hero.dicc.categoria}</span>
        </p>
        <ol class="hg-acepciones">
          {
            acepciones.map(([dicho, sentido], i) => (
              <li
                class:list={["hg-acep", `hg-acep-${i + 1}`]}
                data-mide={
                  i === 0 ? "acepcion-1" : i === 3 ? "acepcion-4" : undefined
                }
              >
                <span class="hg-num font-slab" aria-hidden="true">
                  {i + 1}
                </span>
                <span>
                  <span class="hg-dicho" set:html={dicho} />
                  <span class="hg-sentido" set:html={sentido} />
                </span>
              </li>
            ))
          }
        </ol>
      </div>

      <div
        class="hg-collage"
        data-collage
        data-actual="0"
        role="group"
        aria-label={g.pantallas}
      >
        <div class="pieza hg-retrato" data-mide="foto">
          <Image
            src={fotoSaloAlta}
            widths={[240, 400, 600]}
            sizes="(min-width: 768px) 290px, 110px"
            alt={c.hero.fichaAlt}
            loading="eager"
            fetchpriority="high"
          />
        </div>
        {
          sets.map((set, s) =>
            set.map(p => {
              const { src, alt, titulo } = pantalla(p.archivo);
              return (
                <div
                  class:list={[
                    "pieza",
                    `pieza-${p.tipo}`,
                    p.fundido && "pieza-fundida",
                  ]}
                  data-set={s}
                  data-movil={p.m ? "" : undefined}
                  style={estilo(p)}
                >
                  {p.tipo === "ventana" && (
                    <span class="hg-barra font-mono" aria-hidden="true">
                      {titulo}
                    </span>
                  )}
                  <div class="pieza-marco">
                    <Image
                      src={src}
                      widths={anchos[p.tipo]}
                      sizes={tamanos[p.tipo]}
                      alt={p.tipo === "recorte" ? "" : alt}
                      loading={s === 0 && p.m ? "eager" : "lazy"}
                    />
                  </div>
                </div>
              );
            })
          )
        }
        <button
          type="button"
          class="hg-pausa"
          data-pausa
          aria-pressed="false"
          aria-label={g.pausar}
        >
          <svg viewBox="0 0 16 16" aria-hidden="true">
            <path class="hg-i-pausa" d="M5.5 4v8M10.5 4v8"></path>
            <path class="hg-i-play" d="M5.5 3.8 12 8l-6.5 4.2z"></path>
          </svg>
        </button>
      </div>

      <div class="hg-accion">
        <p class="hg-bajada">
          <b>{cabeza}:</b>{resto.join(":")}
        </p>
        <p class="hg-bajada-corta">{g.bajadaCorta}</p>
        <div class="hg-ctas" data-pliegue data-mide="ctas">
          <a
            href={routes.cuentame[lang]}
            data-origen="hero"
            class="hg-btn hg-btn-1"
          >
            {c.cta.cuestionario}<svg class="hg-flecha" aria-hidden="true"
              ><use href="#i-arw"></use></svg
            >
          </a>
          <a
            href={wa(c.cta.waTexto)}
            target="_blank"
            rel="noopener"
            data-origen="hero"
            class="hg-btn hg-btn-2"
          >
            <svg aria-hidden="true"><use href="#i-chat"></use></svg>{c.cta.wa}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const collage = document.querySelector<HTMLElement>("[data-collage]");
  const boton = collage?.querySelector<HTMLButtonElement>("[data-pausa]");
  if (collage && boton) {
    const total = new Set(
      [...collage.querySelectorAll<HTMLElement>("[data-set]")].map(
        p => p.dataset.set
      )
    ).size;
    const quieto = matchMedia("(prefers-reduced-motion: reduce)");
    const ancho = matchMedia("(min-width: 768px)");
    let actual = 0;
    let reloj = 0;
    const mostrar = (n: number) => {
      actual = n;
      collage.dataset.actual = String(n);
    };
    const parar = () => {
      clearInterval(reloj);
      reloj = 0;
    };
    const andar = () => {
      parar();
      if (!ancho.matches) mostrar(0);
      if (
        quieto.matches ||
        !ancho.matches ||
        document.hidden ||
        boton.ariaPressed === "true"
      )
        return;
      reloj = window.setInterval(() => mostrar((actual + 1) % total), 2800);
    };
    boton.addEventListener("click", () => {
      boton.ariaPressed = boton.ariaPressed === "true" ? "false" : "true";
      andar();
    });
    document.addEventListener("visibilitychange", andar);
    quieto.addEventListener("change", andar);
    ancho.addEventListener("change", andar);
    andar();
  }
</script>

<style>
  .hg {
    --nav: 98px;
    --pad: clamp(10px, 2.2svh, 30px);
    --contenido: calc(min(100vw, 1320px) - 2 * clamp(1.25rem, 4vw, 3.5rem));
    --hueco: clamp(28px, 3vw, 44px);
    --col: var(--contenido);
    --sombra:
      0 1px 2px rgb(22 23 26 / 0.1), 0 20px 44px -22px rgb(22 23 26 / 0.5);
    display: grid;
    align-items: center;
    min-height: calc(100svh - var(--nav));
    padding-block: var(--pad);
  }
  .hg-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 10px;
  }

  /* --col is the headline column's width; line one is about 4.6em wide at
     this width axis, so it fills the column and line two (.462em) matches it */
  .hg-h1 {
    font-size: max(2.6rem, min(var(--col) / 4.75, 9.2svh));
    line-height: 1;
  }
  .hg-l1 {
    display: block;
    font-weight: 900;
    font-variation-settings:
      "wdth" 62,
      "wght" 900;
    font-stretch: 62%;
    text-transform: uppercase;
    line-height: 0.84;
    letter-spacing: 0.004em;
  }
  .hg-l2 {
    display: block;
    margin-top: 0.12em;
    font-size: 0.462em;
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: -0.012em;
  }
  .hg-icp {
    margin-top: 8px;
    max-width: 30ch;
    font-size: clamp(1rem, 0.9rem + 0.45vw, 1.22rem);
    font-weight: 600;
    line-height: 1.3;
    text-wrap: pretty;
  }

  /* dictionary */
  .hg-dicc {
    overflow: hidden;
    border: 1px solid var(--linea);
    border-radius: 3px;
    background: var(--campo);
    padding: 11px 14px 12px;
    box-shadow:
      0 1px 0 rgb(22 23 26 / 0.04),
      0 16px 34px -28px rgb(22 23 26 / 0.55);
  }
  .hg-palabra {
    display: flex;
    align-items: baseline;
    gap: 10px;
    font-size: clamp(1.15rem, 0.9rem + 0.9vw, 1.6rem);
    line-height: 1;
  }
  .hg-cat {
    font-size: 12px;
    font-style: italic;
    color: var(--gris);
  }
  .hg-acepciones {
    margin-top: 8px;
    display: grid;
    gap: 6px;
    font-size: 0.84rem;
    line-height: 1.38;
  }
  .hg-acep {
    display: grid;
    grid-template-columns: 1rem minmax(0, 1fr);
    gap: 5px;
  }
  .hg-acep-2,
  .hg-acep-3 {
    display: none;
  }
  .hg-num {
    font-size: 0.82rem;
    line-height: 1.6;
    color: var(--rojo2);
  }
  .hg-dicho {
    color: var(--gris);
  }
  .hg-acep-4 {
    margin-inline: -14px;
    margin-bottom: -12px;
    padding: 8px 14px 10px;
    border-top: 1px dashed var(--linea);
    background: #fbf3f1;
    font-size: 1.02rem;
    line-height: 1.3;
  }
  .hg-acep-4 .hg-num {
    display: grid;
    place-items: center;
    width: 1.3rem;
    height: 1.3rem;
    margin-top: 0.05rem;
    border-radius: 50%;
    background: var(--rojo2);
    color: #fff;
    font-size: 0.72rem;
    line-height: 1;
  }
  .hg-acep-4 .hg-dicho {
    color: var(--tinta);
  }
  .hg-acep-4 .hg-sentido {
    white-space: nowrap;
    font-weight: 700;
    background: linear-gradient(
      transparent 58%,
      rgb(216 51 42 / 0.26) 58% 92%,
      transparent 92%
    );
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }

  /* collage */
  .hg-collage {
    position: relative;
    container-type: inline-size;
    width: 100%;
    aspect-ratio: 2.3;
  }
  .pieza {
    position: absolute;
    left: var(--mx);
    top: var(--my);
    width: var(--mw);
    z-index: var(--z);
    display: flex;
    flex-direction: column;
    border-radius: 3px;
    background: var(--campo);
    box-shadow: var(--sombra);
    overflow: hidden;
    transition: opacity 0.7s cubic-bezier(0.65, 0, 0.35, 1);
  }
  .pieza[data-set] {
    opacity: 0;
    pointer-events: none;
  }
  .pieza[data-set]:not([data-movil]) {
    display: none;
  }
  .hg-collage[data-actual="0"] .pieza[data-set="0"],
  .hg-collage[data-actual="1"] .pieza[data-set="1"],
  .hg-collage[data-actual="2"] .pieza[data-set="2"] {
    opacity: 1;
  }
  .pieza-marco {
    position: relative;
    flex: 1;
    overflow: hidden;
  }
  .pieza-marco :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 0 0;
  }
  /* softens the edge where a crop cuts through words */
  .pieza-fundida .pieza-marco::after {
    content: "";
    position: absolute;
    inset: 0 0 0 auto;
    width: 34%;
    background: linear-gradient(to right, rgb(255 255 255 / 0), #fff 88%);
  }
  .pieza-recorte .pieza-marco :global(img) {
    inset: auto;
    left: 0;
    top: 0;
    width: calc(100% / var(--cw));
    height: auto;
    max-width: none;
    transform: translate(calc(var(--cx) * -100%), calc(var(--cy) * -100%));
  }
  .hg-barra {
    flex: none;
    display: flex;
    align-items: center;
    gap: 6px;
    height: 7cqw;
    max-height: 22px;
    padding-inline: 2cqw;
    border-bottom: 1px solid var(--linea);
    font-size: 0;
    color: var(--gris);
    white-space: nowrap;
  }
  .hg-barra::before {
    content: "";
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--rojo);
  }
  .pieza-celular {
    padding: 1.1cqw;
    border-radius: 3.4cqw;
    background: var(--tinta);
  }
  .pieza-celular .pieza-marco {
    border-radius: 2.5cqw;
    background: var(--campo);
  }
  .hg-retrato {
    left: 50%;
    top: 0;
    height: 100%;
    width: auto;
    aspect-ratio: 2 / 3;
    translate: -50% 0;
    z-index: 2;
    padding: 4px;
    box-shadow:
      0 1px 2px rgb(22 23 26 / 0.12),
      0 26px 50px -24px rgb(22 23 26 / 0.6);
  }
  .hg-retrato :global(img) {
    width: 100%;
    height: 100%;
    border-radius: 1px;
    object-fit: cover;
    object-position: 50% 30%;
  }
  .hg-pausa {
    display: none;
  }

  /* action */
  .hg-bajada {
    display: none;
  }
  .hg-bajada-corta {
    display: none;
    margin-bottom: 12px;
    font-size: 1rem;
    line-height: 1.4;
  }
  .hg-ctas {
    display: grid;
    gap: 8px;
  }
  .hg-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 46px;
    padding: 10px 18px;
    border-radius: 3px;
    font-size: 0.97rem;
    font-weight: 700;
    line-height: 1.15;
    transition:
      background-color 140ms cubic-bezier(0.2, 0.8, 0.2, 1),
      border-color 140ms cubic-bezier(0.2, 0.8, 0.2, 1),
      transform 140ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .hg-btn svg {
    width: 18px;
    height: 18px;
    flex: none;
  }
  .hg-btn-1 {
    background: var(--rojo2);
    color: #fff;
  }
  .hg-btn-2 {
    border: 1.5px solid var(--linea2);
  }
  .hg-flecha {
    transition: transform 140ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  @media (hover: hover) and (pointer: fine) {
    .hg-btn:hover {
      transform: translateY(-1px);
    }
    .hg-btn-1:hover {
      background: var(--tinta);
    }
    .hg-btn-2:hover {
      border-color: var(--tinta);
      background: var(--papel2);
    }
    .hg-btn:hover .hg-flecha {
      transform: translateX(3px);
    }
  }
  .hg-btn:active {
    transform: translateY(1px) scale(0.985);
    transition-duration: 90ms;
  }

  /* phone: text, the strip, the entry, the buttons */
  @media (max-width: 767px) {
    .hg {
      --pad: 10px;
    }
    .hg-grid {
      grid-template-areas: "texto" "collage" "dicc" "accion";
    }
    .hg-texto {
      grid-area: texto;
    }
    .hg-collage {
      grid-area: collage;
      aspect-ratio: 2.5;
    }
    .hg-dicc {
      grid-area: dicc;
      padding-inline: 12px;
    }
    .hg-acep-4 {
      margin-inline: -12px;
      padding-inline: 12px;
    }
    .hg-accion {
      grid-area: accion;
      margin-top: 2px;
    }
  }
  @media (max-width: 767px) and (min-height: 760px) {
    .hg {
      --pad: 16px;
    }
    .hg-grid {
      gap: 14px;
    }
    .hg-bajada-corta {
      display: block;
    }
    .hg-collage {
      aspect-ratio: 1.9;
    }
  }

  /* tablet and small desktop: the words left, the collage right */
  @media (min-width: 768px) {
    .hg {
      --nav: 61px;
      --col: calc((var(--contenido) - var(--hueco)) * 1.35 / 2.35);
    }
    .hg-grid {
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
      grid-template-rows: auto auto 1fr;
      grid-template-areas: "texto collage" "dicc collage" "accion collage";
      column-gap: var(--hueco);
      row-gap: clamp(14px, 2.4svh, 24px);
      align-items: start;
    }
    .hg-texto {
      grid-area: texto;
    }
    .hg-dicc {
      grid-area: dicc;
      padding: 16px 20px;
    }
    .hg-accion {
      grid-area: accion;
    }
    .hg-h1 {
      font-size: max(3.2rem, min(var(--col) / 4.75, 10.5svh));
    }
    .hg-icp {
      margin-top: 14px;
    }
    .hg-acep {
      grid-template-columns: 1.15rem minmax(0, 1fr);
      gap: 6px;
    }
    .hg-acep-2,
    .hg-acep-3 {
      display: grid;
    }
    .hg-acepciones {
      margin-top: 12px;
      gap: 8px;
      font-size: 0.92rem;
    }
    .hg-acep-4 {
      margin-inline: -20px;
      margin-bottom: -16px;
      margin-top: 2px;
      padding: 10px 20px 12px;
      font-size: 1.08rem;
    }
    .hg-collage {
      grid-area: collage;
      align-self: center;
      width: min(100%, calc((100svh - var(--nav) - 2 * var(--pad)) * 2 / 3));
      justify-self: center;
      aspect-ratio: 2 / 3;
    }
    .pieza {
      left: var(--x);
      top: var(--y);
      width: var(--w);
    }
    .pieza[data-set]:not([data-movil]) {
      display: flex;
    }
    .hg-retrato {
      left: 21%;
      top: 40%;
      width: 58%;
      height: auto;
      translate: none;
      padding: 1.3cqw;
    }
    .hg-barra {
      font-size: max(9px, 1.9cqw);
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }
    .hg-pausa {
      position: absolute;
      z-index: 4;
      right: calc(21% + 2.6cqw);
      bottom: 3.4%;
      display: grid;
      place-items: center;
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: rgb(22 23 26 / 0.86);
      color: #fff;
      box-shadow: 0 0 0 1px rgb(255 255 255 / 0.35);
      transition: background-color 140ms;
