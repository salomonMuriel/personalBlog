---
import { Image } from "astro:assets";
import retrato from "@assets/heroes/a/salo-cartel.jpg";

interface Props {
  alt: string;
}
const { alt } = Astro.props;
---

<div class="a3-foto" data-mide="foto">
  <Image
    src={retrato}
    widths={[480, 667]}
    sizes="(min-width:1024px) 667px, 110vw"
    alt={alt}
    loading="eager"
    fetchpriority="high"
  />
</div>

<style>
  /* No frame: the portrait dissolves into the stage. Sizes come from the hero
     (--img-h, --margen, and on desktops --foto-w, --l1, --tira-w). */
  .a3-foto {
    position: relative;
    z-index: 0;
    order: 1;
    /* Grows on tall phones and tablets, showing more of the coat and arms. */
    flex: 1 0 auto;
    height: calc(var(--img-h) * 0.31);
    margin-top: var(--foto-arriba, 6px);
    margin-inline: calc(var(--margen) * -1);
    overflow: hidden;
    /* The img blends with this, not with the stage: the mask isolates it. */
    background:
      radial-gradient(
        ellipse 34% 62% at 50% 40%,
        rgba(236, 234, 228, 0.1),
        transparent 72%
      ),
      var(--hondo);
    mask-image:
      linear-gradient(to bottom, #000 58%, transparent 100%),
      linear-gradient(
        to right,
        transparent 0,
        #000 18%,
        #000 82%,
        transparent 100%
      );
    mask-composite: intersect;
  }
  .a3-foto :global(img) {
    position: absolute;
    left: 50%;
    /* The head starts at 28% of the frame and the chin ends near 52%. */
    top: calc(var(--img-h) * -0.265);
    height: var(--img-h);
    width: auto;
    max-width: none;
    translate: -50% 0;
    mix-blend-mode: lighten;
    filter: grayscale(1) contrast(1.14) brightness(1.03);
  }

  @media (min-width: 1024px) {
    .a3-foto {
      position: absolute;
      order: 0;
      top: 0;
      bottom: 0;
      height: auto;
      margin: 0;
      /* Centred between the title (about 4.59 × --l1 wide) and the strip. */
      left: calc(
        var(--izquierda) +
          (var(--l1) * 4.59 + var(--contenido) - var(--tira-w)) / 2 -
          var(--foto-w) / 2
      );
      width: var(--foto-w);
      background:
        radial-gradient(
          ellipse 38% 34% at 50% 26%,
          rgba(236, 234, 228, 0.1),
          transparent 72%
        ),
        linear-gradient(to bottom, transparent 62%, var(--tinta)), var(--hondo);
      mask-image:
        linear-gradient(to bottom, #000 66%, transparent 96%),
        linear-gradient(
          to right,
          transparent 0,
          #000 22%,
          #000 86%,
          transparent 100%
        );
    }
    .a3-foto :global(img) {
      left: 0;
      top: calc(var(--img-h) * -0.14);
      translate: none;
    }
  }
</style>
