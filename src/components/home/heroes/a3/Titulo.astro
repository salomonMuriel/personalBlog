---
import { copia } from "@data/landing";
import { palabras } from "@data/heroes/palabras";
import type { Lang } from "@i18n/ui";

interface Props {
  lang: Lang;
  id: string;
}
const { lang, id } = Astro.props;
const c = copia(lang).hero;
---

<h1 id={id} class="a3t" data-mide="h1">
  <span class="a3t__l1 font-arch">{c.linea1}</span>
  <span
    class="a3t__slot font-slab"
    data-a3-slot
    data-frases={JSON.stringify(palabras[lang])}
    ><span class="a3t__l2" data-a3-reposo>{c.linea2}</span></span
  >
</h1>
<script is:inline>
  // Each pain shows once, fitted to the title's width, then the line rests on its
  // real words. The phrases live in an aria-hidden layer; the h1 text never changes.
  (() => {
    const slot = document.querySelector("[data-a3-slot]");
    if (!slot || matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    const h1 = slot.closest("h1");
    const reposo = slot.querySelector("[data-a3-reposo]");
    const frases = JSON.parse(slot.dataset.frases);
    const paso = 1600;
    const espera = ms => new Promise(r => setTimeout(r, ms));
    const fijar = (el, estado) => {
      el.style.transition = "none";
      el.dataset.estado = estado;
      void el.offsetWidth;
      el.style.transition = "";
    };
    const ajustar = capas => {
      const ancho = Math.max(
        h1.firstElementChild.offsetWidth,
        reposo.offsetWidth
      );
      capas.forEach(capa => {
        capa.style.fontSize = "";
        const natural = capa.firstElementChild.offsetWidth;
        capa.style.fontSize = `${Math.min(1, ancho / natural)}em`;
      });
    };
    const crear = () => {
      const capas = frases.map(texto => {
        const capa = document.createElement("span");
        capa.className = "a3t__frase";
        capa.setAttribute("aria-hidden", "true");
        const linea = document.createElement("span");
        linea.textContent = texto;
        capa.append(linea);
        slot.append(capa);
        fijar(capa, "abajo");
        return capa;
      });
      ajustar(capas);
      return capas;
    };
    let corriendo = false;
    const recorrer = async (pasos, primera) => {
      corriendo = true;
      for (let i = 1; i < pasos.length; i++) {
        await espera(i === 1 ? primera : paso);
        const sale = pasos[i - 1];
        sale.dataset.estado = "arriba";
        pasos[i].dataset.estado = "";
        setTimeout(() => fijar(sale, "abajo"), 500);
      }
      await espera(600);
      slot.querySelectorAll(".a3t__frase").forEach(capa => capa.remove());
      corriendo = false;
    };
    const capas = crear();
    fijar(capas[0], "");
    fijar(reposo, "abajo");
    document.fonts.ready.then(() => ajustar(capas));
    recorrer([...capas, reposo], paso);
    h1.addEventListener("pointerenter", e => {
      if (e.pointerType !== "mouse" || corriendo) return;
      recorrer([reposo, ...crear(), reposo], 60);
    });
  })();
</script>

<style>
  .a3t {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .a3t__l1 {
    display: block;
    white-space: nowrap;
    font-size: var(--l1);
    line-height: 0.8;
    text-transform: uppercase;
    font-stretch: 62%;
    font-variation-settings:
      "wdth" 62,
      "wght" 900;
    letter-spacing: 0.004em;
    color: var(--papel);
  }

  /* The slot keeps the resting line's box, so the phrases never move the layout. */
  .a3t__slot {
    position: relative;
    display: block;
    margin-top: 0.16em;
    /* Sized so both lines lock up to the same width. */
    font-size: calc(var(--l1) * 0.466);
    line-height: 0.95;
    text-transform: uppercase;
    letter-spacing: -0.012em;
    color: var(--rojo3);
    white-space: nowrap;
    clip-path: inset(-0.35em -2em -0.25em -2em);
  }
  .a3t__l2,
  .a3t__slot :global(.a3t__frase) {
    display: block;
    /* The incoming phrase waits for the outgoing one to clear. */
    transition:
      opacity 0.38s cubic-bezier(0.2, 0.8, 0.2, 1) 0.1s,
      translate 0.46s cubic-bezier(0.2, 0.8, 0.2, 1) 0.1s;
  }
  .a3t__slot :global(.a3t__frase) {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
  }
  .a3t__slot :global(.a3t__frase > span) {
    display: block;
  }
  .a3t__slot :global([data-estado="abajo"]) {
    opacity: 0;
    translate: 0 0.7em;
  }
  .a3t__slot :global([data-estado="arriba"]) {
    opacity: 0;
    translate: 0 -0.7em;
    transition-duration: 0.26s, 0.32s;
    transition-delay: 0s;
  }
</style>
