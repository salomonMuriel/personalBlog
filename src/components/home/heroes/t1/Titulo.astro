---
interface Props {
  id: string;
  linea1: string;
  linea2: string;
  frases: readonly string[];
}
const { id, linea1, linea2, frases } = Astro.props;
---

<h1 {id} class="t1-titulo" data-mide="h1">
  <span class="t1-l1 font-arch">{linea1}</span>
  <span
    class="t1-l2 font-slab"
    data-t1-slot
    data-frases={JSON.stringify(frases)}
    ><span class="t1-reposo"
      >{linea2}<svg
        class="t1-subrayado"
        viewBox="0 0 1000 30"
        preserveAspectRatio="none"
        aria-hidden="true"
        ><defs
          ><mask
            id="t1-pincel"
            maskUnits="userSpaceOnUse"
            x="-20"
            y="-20"
            width="1040"
            height="70"
            ><path
              class="t1-trazo"
              pathLength="1"
              d="M-10 15.5C300 12.8 700 11.0 1010 10.8"></path></mask
          ></defs
        ><path
          class="t1-brocha"
          mask="url(#t1-pincel)"
          fill-rule="evenodd"
          d="M8 6.2C13 5.7 25 3.9 40 3.1C55 2.4 78 2.2 100 1.8C122 1.5 147 1.2 170 1.1C193 1.1 215 1.5 240 1.5C265 1.5 293 1.5 320 1.3C347 1.1 373 0.4 400 0.3C427 0.2 453 0.5 480 0.6C507 0.7 533 0.9 560 0.8C587 0.7 613 0.1 640 0.0C667 -0.0 693 0.2 720 0.4C747 0.7 777 1.3 800 1.7C823 2.0 842 2.1 860 2.3C878 2.6 895 2.9 910 3.3C925 3.8 938 4.5 950 5.2C962 6.0 971 6.7 980 7.6C989 8.6 998 10.3 1002 10.8C998 11.4 989 13.3 980 14.2C971 15.1 962 15.6 950 16.2C938 16.8 925 17.3 910 17.8C895 18.3 878 18.7 860 19.2C842 19.7 823 20.3 800 20.9C777 21.5 747 22.2 720 22.6C693 23.0 667 23.2 640 23.3C613 23.4 587 23.2 560 23.2C533 23.2 507 23.3 480 23.6C453 23.8 427 24.4 400 24.8C373 25.2 347 25.6 320 25.9C293 26.1 265 26.1 240 26.2C215 26.2 193 26.2 170 26.3C147 26.4 122 26.7 100 27.0C78 27.2 55 27.9 40 27.6C25 27.3 13 25.7 8 25.3C1 24.7 -1 7.4 8 6.2ZM540 7.4C557 7.3 607 6.8 640 6.6C673 6.5 707 6.4 740 6.4C773 6.4 807 6.5 840 6.9C873 7.3 923 8.3 940 8.6C923 8.5 873 8.0 840 7.9C807 7.8 773 7.8 740 7.8C707 7.8 673 7.7 640 7.6C607 7.6 557 7.4 540 7.4ZM660 16.5C672 16.4 710 15.9 735 15.7C760 15.4 785 15.2 810 15.0C835 14.7 860 14.5 885 14.2C910 13.8 948 13.1 960 12.9C948 13.2 910 14.4 885 15.0C860 15.5 835 15.8 810 16.1C785 16.3 760 16.4 735 16.4C710 16.5 672 16.5 660 16.5ZM280 16.4C292 16.2 327 15.8 350 15.6C373 15.3 397 15.1 420 15.0C443 14.9 467 14.8 490 14.7C513 14.7 548 14.7 560 14.7C548 14.8 513 15.2 490 15.4C467 15.6 443 15.8 420 15.9C397 16.0 373 16.1 350 16.2C327 16.3 292 16.3 280 16.4Z"
        ></path></svg
      ></span
    ></span
  >
</h1>
<script is:inline>
  (() => {
    const slot = document.querySelector("[data-t1-slot]");
    if (!slot || matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    const titulo = slot.parentElement;
    const medida = slot.previousElementSibling;
    const reposo = slot.querySelector(".t1-reposo");
    const trazo = slot.querySelector(".t1-trazo");
    // ?lento=4 plays the whole cycle four times slower, for reviewing the easing.
    const lento =
      Number(new URLSearchParams(location.search).get("lento")) || 1;

    // One pen stroke per chore, each a little different, in a box 0.01em per unit.
    const RAYAS = [
      "M6 25C240 23.5 520 22 760 19.6S960 16 1004 15.4",
      "M6 17.5C220 21.5 620 23.5 1004 19",
      "M6 28C300 25 700 17 1004 12",
      "M6 21.5C330 20.5 690 22 960 19.6 980 19.4 996 20.8 1004 23",
      "M6 15C260 18 640 22.5 1004 24.5",
      "M6 27C360 22 640 19.5 1004 13",
    ];
    // Per chore, from its onset (ms): rise, word stagger, strike start and length, exit start and length.
    // The montage speeds up: the first one is read, the last ones flash past.
    const GUION = [
      {
        sube: 520,
        escalon: 55,
        tacha: 900,
        traza: 320,
        sale: 1320,
        salida: 240,
      },
      {
        sube: 440,
        escalon: 40,
        tacha: 500,
        traza: 250,
        sale: 800,
        salida: 210,
      },
      {
        sube: 380,
        escalon: 32,
        tacha: 380,
        traza: 210,
        sale: 630,
        salida: 180,
      },
      {
        sube: 330,
        escalon: 26,
        tacha: 300,
        traza: 180,
        sale: 510,
        salida: 165,
      },
      {
        sube: 290,
        escalon: 20,
        tacha: 230,
        traza: 160,
        sale: 420,
        salida: 155,
      },
      {
        sube: 270,
        escalon: 16,
        tacha: 200,
        traza: 150,
        sale: 380,
        salida: 150,
      },
    ];
    // The next chore starts rising when the previous one is three quarters of the way out.
    const RELEVO = 0.75;
    const PAUSA = 110;
    const SELLO = 520;
    const SUBRAYA = 210;
    const PINCELADA = 480;
    const PRELUDIO = 200;

    const PLUMA = [0.45, 0, 0.15, 1];
    const CURVAS = {
      sube: "cubic-bezier(0.22, 1, 0.36, 1)",
      sale: "cubic-bezier(0.32, 0, 0.67, 0)",
      apaga: "cubic-bezier(0.3, 0, 0.6, 1)",
      pluma: `cubic-bezier(${PLUMA})`,
      sello: "cubic-bezier(0.16, 1, 0.3, 1)",
      enfoca: "cubic-bezier(0.33, 1, 0.68, 1)",
      pincel: "cubic-bezier(0.5, 0, 0.2, 1)",
    };
    const bezier = (x1, y1, x2, y2) => {
      const eje = (a, b, s) =>
        3 * a * s * (1 - s) ** 2 + 3 * b * s * s * (1 - s) + s ** 3;
      return t => {
        let bajo = 0;
        let alto = 1;
        for (let k = 0; k < 22; k++) {
          const s = (bajo + alto) / 2;
          if (eje(x1, x2, s) < t) bajo = s;
          else alto = s;
        }
        return eje(y1, y2, (bajo + alto) / 2);
      };
    };
    // When the pen reaches a point of its stroke, so each word greys out as it is crossed.
    const pluma = bezier(...PLUMA);
    const cuandoLlega = avance => {
      let bajo = 0;
      let alto = 1;
      for (let k = 0; k < 20; k++) {
        const m = (bajo + alto) / 2;
        if (pluma(m) < avance) bajo = m;
        else alto = m;
      }
      return alto;
    };

    const tramoya = document.createElement("span");
    tramoya.className = "t1-tramoya";
    tramoya.setAttribute("aria-hidden", "true");
    const capas = JSON.parse(slot.dataset.frases).map((texto, i) => {
      const capa = document.createElement("span");
      capa.className = "t1-frase";
      const linea = document.createElement("span");
      linea.className = "t1-linea";
      const palabras = texto.split(" ").map((palabra, j) => {
        const caja = document.createElement("span");
        caja.className = "t1-palabra";
        caja.textContent = palabra;
        if (j) linea.append(" ");
        linea.append(caja);
        return caja;
      });
      capa.append(linea);
      capa.insertAdjacentHTML(
        "beforeend",
        `<svg class="t1-raya" viewBox="0 0 1010 40" preserveAspectRatio="none"><path pathLength="1" d="${RAYAS[i % RAYAS.length]}"/></svg>`
      );
      tramoya.append(capa);
      return { capa, linea, palabras, raya: capa.querySelector("path") };
    });
    slot.append(tramoya);

    // Every chore is set to the width of «SE ARREGLA» through the width axis, at one size.
    const ajustar = () => {
      const objetivo = medida.getBoundingClientRect().width;
      for (const { capa, linea } of capas) {
        capa.style.setProperty("--t1-ajuste", "1");
        capa.style.setProperty("--t1-wdth", "62");
        const angosto = linea.getBoundingClientRect().width;
        capa.style.setProperty("--t1-wdth", "100");
        const ancho = linea.getBoundingClientRect().width;
        const wdth = Math.min(
          100,
          Math.max(62, 62 + (38 * (objetivo - angosto)) / (ancho - angosto))
        );
        capa.style.setProperty("--t1-wdth", wdth.toFixed(2));
        const ajuste = objetivo / linea.getBoundingClientRect().width;
        capa.style.setProperty(
          "--t1-ajuste",
          Math.min(1.04, ajuste).toFixed(4)
        );
      }
    };
    const observador = new ResizeObserver(ajustar);
    observador.observe(medida);
    document.fonts?.ready.then(ajustar);

    const estilo = getComputedStyle(slot);
    const vivo = estilo.getPropertyValue("--t1-vivo").trim();
    const muerto = estilo.getPropertyValue("--t1-muerto").trim();

    let corriendo = false;
    const correr = repeticion => {
      ajustar();
      const pistas = [];
      const pista = (el, propiedad, claves) =>
        pistas.push({ el, propiedad, claves });
      const em = parseFloat(estilo.fontSize);
      let inicio = repeticion ? PRELUDIO - 40 : 0;
      let fin = 0;

      for (const [i, { capa, palabras, raya }] of capas.entries()) {
        // On a replay the first chore was already read: it runs at the second one's pace.
        const g =
          GUION[Math.min(repeticion ? Math.max(i, 1) : i, GUION.length - 1)];
        const salida = inicio + g.sale + g.salida;
        pista(capa, "visibility", [
          [inicio - 1, "hidden"],
          [inicio, "visible"],
          [salida, "visible"],
          [salida + 1, "hidden"],
        ]);
        pista(capa, "transform", [
          [inicio + g.sale, "translateY(0)", CURVAS.sale],
          [salida, "translateY(-1.2em)"],
        ]);
        // Gone before its strike reaches the first line, which would read as underlining it.
        pista(capa, "opacity", [
          [inicio + g.sale + g.salida * 0.4, "1", CURVAS.apaga],
          [salida, "0"],
        ]);
        const ancho = capa.offsetWidth + 0.24 * em;
        for (const [j, palabra] of palabras.entries()) {
          const t = inicio + j * g.escalon;
          pista(palabra, "transform", [
            [t, "translateY(1.3em)", CURVAS.sube],
            [t + g.sube, "translateY(0)"],
          ]);
          const centro =
            palabra.offsetLeft + palabra.offsetWidth * 0.4 + 0.12 * em;
          const tocada =
            inicio + g.tacha + g.traza * cuandoLlega(centro / ancho);
          pista(palabra, "color", [
            [tocada, vivo, "ease-out"],
            [tocada + 90, muerto],
          ]);
        }
        pista(raya, "strokeDashoffset", [
          [inicio + g.tacha, "1.02", CURVAS.pluma],
          [inicio + g.tacha + g.traza, "0"],
        ]);
        fin = salida;
        inicio += g.sale + g.salida * RELEVO;
      }

      const sello = fin + PAUSA;
      const subraya = sello + SUBRAYA;
      // A replay first sends the resting words back, the way they came.
      const previo = (desde, hasta) =>
        repeticion
          ? [
              [0, desde, CURVAS.sale],
              [PRELUDIO, hasta],
            ]
          : [];
      pista(reposo, "opacity", [
        ...previo("1", "0"),
        [sello - 1, "0"],
        [sello, "0.4", CURVAS.enfoca],
        [sello + 140, "1"],
      ]);
      pista(reposo, "transform", [
        ...previo("scale(1)", "scale(0.94)"),
        [sello, "scale(1.16)", CURVAS.sello],
        [sello + SELLO, "scale(1)"],
      ]);
      pista(reposo, "filter", [
        ...previo("blur(0)", "blur(0.05em)"),
        [sello, "blur(0.08em)", CURVAS.enfoca],
        [sello + 300, "blur(0)"],
      ]);
      pista(trazo, "strokeDashoffset", [
        ...previo("0", "0"),
        [repeticion ? PRELUDIO : 0, "1.02"],
        [subraya, "1.02", CURVAS.pincel],
        [subraya + PINCELADA, "0"],
      ]);

      const total = subraya + PINCELADA;
      const animaciones = pistas.map(({ el, propiedad, claves }) => {
        const cuadros = claves.map(([ms, valor, curva]) => ({
          offset: Math.min(1, Math.max(0, ms / total)),
          [propiedad]: valor,
          easing: curva ?? "linear",
        }));
        if (cuadros[0].offset > 0)
          cuadros.unshift({ ...cuadros[0], offset: 0, easing: "linear" });
        if (cuadros.at(-1).offset < 1)
          cuadros.push({ ...cuadros.at(-1), offset: 1 });
        return el.animate(cuadros, { duration: total * lento, fill: "both" });
      });
      corriendo = true;
      slot.dataset.t1Estado = "corre";
      // Cancelling at the end hands the rest state back to the CSS. An animation cancelled
      // from outside rejects `finished`; the cycle simply ends there.
      Promise.all(animaciones.map(a => a.finished))
        .then(() => animaciones.forEach(a => a.cancel()))
        .catch(() => animaciones.forEach(a => a.cancel()))
        .finally(() => {
          corriendo = false;
          delete slot.dataset.t1Estado;
        });
    };

    if (document.visibilityState === "visible") correr(false);
    else
      document.addEventListener("visibilitychange", () => correr(false), {
        once: true,
      });
    titulo.addEventListener("pointerenter", e => {
      if (e.pointerType === "mouse" && !corriendo) correr(true);
    });
  })();
</script>
