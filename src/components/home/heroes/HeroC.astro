---
import { Image } from "astro:assets";
import { wa } from "@config";
import { copia } from "@data/landing";
import { heroC } from "@data/heroes/c";
import { routes, type Lang } from "@i18n/ui";
import fotoSalo from "@assets/site/fotoSaloAlta.jpg";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = copia(lang).hero;
const cta = copia(lang).cta;
const h = heroC;

const letras = "ABCDEFGHIJKLMN".split("");
const filas = Array.from({ length: 40 }, (_, i) => i + 1);
const acepciones = c.dicc.acepciones.map(a => {
  const corte = a.indexOf(":") + 1;
  return { rotulo: a.slice(0, corte), texto: a.slice(corte).trim() };
});
const asas = ["nw", "n", "ne", "e", "se", "s", "sw", "w"];
---

<section class="hc" aria-labelledby="hc-titulo">
  <div class="hc-fx" aria-hidden="true">
    <div class="hc-nombre">
      <span class="hc-solo-xl">{h.celdaEscritorio}</span><span class="hc-no-xl"
        >{h.celdaMovil}</span
      >
      <svg viewBox="0 0 10 6" class="hc-chevron"
        ><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor"></path></svg
      >
    </div>
    <div class="hc-fxicono">
      <svg viewBox="0 0 12 12" class="hc-solo-sm"
        ><path
          d="M2.5 2.5l7 7M9.5 2.5l-7 7"
          stroke="currentColor"
          stroke-width="1.4"></path></svg
      >
      <svg viewBox="0 0 12 12" class="hc-solo-sm"
        ><path
          d="M2 6.5l2.6 2.6L10 3.5"
          fill="none"
          stroke="currentColor"
          stroke-width="1.4"></path></svg
      >
      <i>fx</i>
    </div>
    <div class="hc-formula">
      <span class="hc-solo-sm">{h.formula}</span><span class="hc-no-sm"
        >{h.formulaCorta}</span
      ><span class="hc-cursor"></span>
    </div>
  </div>

  <div class="hc-cols" aria-hidden="true">
    <span class="hc-cols-marca"></span>
    {
      letras.map((l, i) => (
        <span class="hc-letra" style={`grid-column:${i + 2}`}>
          {l}
        </span>
      ))
    }
  </div>

  <div class="hc-cuerpo">
    <div class="hc-capa hc-rejilla" aria-hidden="true">
      {letras.map((_, i) => <span style={`grid-column:${i + 2}`} />)}
    </div>
    <div class="hc-capa hc-filas" aria-hidden="true">
      <span class="hc-filas-marca"></span>
      {filas.map(n => <span style={`grid-row:${n}`}>{n}</span>)}
    </div>

    <h1 id="hc-titulo" class="hc-h1" data-mide="h1">
      <span class="hc-l1">{c.linea1}</span>
      <span class="hc-l2">{c.linea2}</span>
      <span class="hc-asa-relleno" aria-hidden="true"></span>
    </h1>

    <p class="hc-icp" data-mide="icp">{h.icp}</p>

    <p class="hc-bajada">
      <span class="hc-solo-sm">{c.bajada}</span><span class="hc-no-sm"
        >{h.bajadaCorta}</span
      >
    </p>

    <div class="hc-ctas" data-pliegue data-mide="ctas">
      <a
        href={routes.cuentame[lang]}
        data-origen="hero"
        class="hc-boton hc-boton-1"
      >
        {cta.cuestionario}<svg class="hc-solo-sm" aria-hidden="true"
          ><use href="#i-arw"></use></svg
        >
      </a>
      <a
        href={wa(cta.waTexto)}
        target="_blank"
        rel="noopener"
        data-origen="hero"
        class="hc-boton hc-boton-2"
      >
        <svg aria-hidden="true"><use href="#i-chat"></use></svg><span
          class="hc-solo-sm">{cta.wa}</span
        ><span class="hc-no-sm">{h.waCorto}</span>
      </a>
    </div>

    <div class="hc-nota" role="note" aria-label={h.notaEtiqueta}>
      <svg
        class="hc-conector"
        viewBox="0 0 10 10"
        preserveAspectRatio="none"
        aria-hidden="true"
        ><line x1="0" y1="0" x2="10" y2="10" vector-effect="non-scaling-stroke"
        ></line></svg
      >
      <p class="hc-palabra">
        {c.dicc.palabra}
        <span class="hc-cat">{c.dicc.categoria}</span>
      </p>
      <ol class="hc-acepciones">
        {
          acepciones.map((a, i) => (
            <li
              class:list={[
                "hc-acepcion",
                i === 3 && "hc-estrella",
                (i === 1 || i === 2) && "hc-menor",
              ]}
              data-mide={
                i === 0 ? "acepcion-1" : i === 3 ? "acepcion-4" : undefined
              }
            >
              <span class="hc-num">{i + 1}.</span>
              <span>
                <span class="hc-rotulo">{a.rotulo}</span>{" "}
                <span class="hc-def" set:html={a.texto} />
              </span>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="hc-foto" data-mide="foto">
      <div class="hc-foto-marco">
        <Image
          src={fotoSalo}
          widths={[240, 360, 480, 667]}
          sizes="(min-width: 1024px) 26vw, (min-width: 640px) 44vw, 140px"
          alt={c.fichaAlt}
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <span class="hc-giro" aria-hidden="true"
        ><svg viewBox="0 0 16 16"
          ><path
            d="M12.5 5.5A5 5 0 1 0 13 9"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"></path><path
            d="M13 2.5v3.2H9.8"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"></path></svg
        ></span
      >
      {asas.map(a => <span class={`hc-asa hc-asa-${a}`} aria-hidden="true" />)}
    </div>

    <div class="hc-cuadre" aria-hidden="true">
      {
        h.cuadre.map(([k, v], i) => (
          <>
            <span class="hc-cuadre-k" style={`grid-row:${i + 1}`}>
              {k}
            </span>
            <span
              class:list={["hc-cuadre-v", i === 2 && "hc-error"]}
              style={`grid-row:${i + 1}`}
            >
              {v}
            </span>
          </>
        ))
      }
    </div>
  </div>

  <div class="hc-pestanas" aria-hidden="true">
    <span class="hc-pest-boton"
      ><svg viewBox="0 0 12 12"
        ><path d="M6 1.5v9M1.5 6h9" stroke="currentColor" stroke-width="1.4"
        ></path></svg
      ></span
    >
    <span class="hc-pest-boton hc-solo-sm"
      ><svg viewBox="0 0 12 12"
        ><path
          d="M1.5 3h9M1.5 6h9M1.5 9h9"
          stroke="currentColor"
          stroke-width="1.4"></path></svg
      ></span
    >
    <div class="hc-pest-lista" tabindex="-1">
      <span class="hc-pest hc-pest-activa">{h.pestanaActiva}</span>
      {h.pestanas.map(p => <span class="hc-pest">{p}</span>)}
    </div>
  </div>
</section>

<style>
  /* Every placement is a grid line pair so the selection, the column and row
     highlights and the ruled layer all come from the same numbers. */
  .hc {
    --nav: 98px;
    --fbar: 32px;
    --chead: 20px;
    --tabs: 32px;
    --gut: 26px;
    --resto: 14px;
    --n: 4;
    --rows: 19;
    --row-min: 22px;
    --row-max: 32px;
    --alto: calc(
      100svh - var(--nav) - var(--fbar) - var(--chead) - var(--tabs)
    );
    --row: clamp(
      var(--row-min),
      round(down, calc(var(--alto) / var(--rows)), 1px),
      var(--row-max)
    );
    --cols: var(--gut) repeat(var(--n), minmax(0, 1fr)) var(--resto);
    --rejilla: #e2e0d8;
    --borde: #cfcdc4;

    --h1-c: 2 / 6;
    --h1-r: 2 / 6;
    --h1-n: 4;
    --icp-c: 2 / 6;
    --icp-r: 6 / 8;
    --nota-c: 2 / 6;
    --nota-r: 8 / 16;
    --foto-c: 4 / 6;
    --foto-r: 8 / 16;
    --baj-c: 2 / 6;
    --baj-r: 16 / 18;
    --cta-c: 2 / 6;
    --cta-r: 18 / 20;
    --cuadre-c: 2 / 5;
    --cuadre-r: 19 / 22;

    position: relative;
    display: flex;
    flex-direction: column;
    min-height: calc(100svh - var(--nav));
    background: var(--color-campo);
    overflow-x: clip;
    font-family: var(--font-arch);
  }

  /* ── formula bar ── */
  .hc-fx {
    display: flex;
    flex: none;
    height: var(--fbar);
    align-items: stretch;
    border-block: 1px solid var(--borde);
    background: var(--color-campo);
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-tinta);
  }
  .hc-nombre {
    display: flex;
    width: calc(var(--gut) + 40px);
    flex: none;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
    padding-inline: 8px;
    border-right: 1px solid var(--borde);
    font-weight: 500;
  }
  .hc-chevron {
    width: 8px;
    height: 6px;
    color: var(--color-gris);
  }
  .hc-fxicono {
    display: flex;
    flex: none;
    align-items: center;
    gap: 10px;
    padding-inline: 10px;
    border-right: 1px solid var(--borde);
    color: var(--color-gris);
  }
  .hc-fxicono svg {
    width: 11px;
    height: 11px;
  }
  .hc-fxicono i {
    font-family: var(--font-slab);
    font-size: 12px;
    font-style: normal;
    letter-spacing: -0.02em;
  }
  .hc-formula {
    display: flex;
    min-width: 0;
    flex: 1;
    align-items: center;
    padding-inline: 10px;
    overflow: hidden;
    white-space: nowrap;
  }
  .hc-cursor {
    display: inline-block;
    width: 1.5px;
    height: 15px;
    margin-left: 1px;
    flex: none;
    background: var(--color-rojo);
    animation: hc-parpadeo 1.05s steps(1) 0.6s 6;
  }
  @keyframes hc-parpadeo {
    50% {
      opacity: 0;
    }
  }

  /* ── column headers ── */
  .hc-cols {
    display: grid;
    flex: none;
    height: var(--chead);
    grid-template-columns: var(--cols);
    grid-auto-columns: 0;
    overflow: hidden;
    border-bottom: 1px solid var(--borde);
    background: var(--color-papel2);
    font-size: 11px;
    font-weight: 500;
    color: var(--color-gris);
  }
  .hc-letra {
    display: grid;
    grid-row: 1;
    place-items: center;
    overflow: hidden;
    border-left: 1px solid var(--borde);
  }
  .hc-cols-marca {
    grid-column: var(--h1-c);
    grid-row: 1;
    background: rgba(216, 51, 42, 0.12);
    box-shadow: inset 0 -2px 0 var(--color-rojo);
  }

  /* ── sheet body ── */
  .hc-cuerpo {
    cursor: cell;
    position: relative;
    display: grid;
    flex: 1 0 auto;
    grid-template-columns: var(--cols);
    grid-template-rows: repeat(var(--rows), var(--row));
    grid-auto-rows: var(--row);
    align-content: start;
    container-type: inline-size;
    --col: calc((100cqi - var(--gut) - var(--resto)) / var(--n));
  }
  .hc-capa {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .hc-rejilla {
    display: grid;
    grid-template-columns: var(--cols);
    grid-auto-columns: 0;
    overflow: hidden;
    background-image: linear-gradient(
      to bottom,
      transparent calc(var(--row) - 1px),
      var(--rejilla) 0
    );
    background-size: 100% var(--row);
  }
  .hc-rejilla > span {
    grid-row: 1;
    border-left: 1px solid var(--rejilla);
  }
  .hc-filas {
    right: auto;
    display: grid;
    width: var(--gut);
    grid-template-rows: repeat(40, var(--row));
    overflow: hidden;
    border-right: 1px solid var(--borde);
    background: var(--color-papel2);
    font-size: 10.5px;
    font-weight: 500;
    color: var(--color-gris);
  }
  .hc-filas > span {
    display: grid;
    grid-column: 1;
    place-items: center;
    border-bottom: 1px solid var(--borde);
  }
  .hc-filas > .hc-filas-marca {
    grid-row: var(--h1-r);
    border: 0;
    background: rgba(216, 51, 42, 0.12);
    box-shadow: inset -2px 0 0 var(--color-rojo);
  }
  .hc-cuerpo > :not(.hc-capa) {
    position: relative;
    z-index: 1;
  }

  /* ── h1: the selected merged range ── */
  .hc-h1 {
    display: flex;
    grid-column: var(--h1-c);
    grid-row: var(--h1-r);
    flex-direction: column;
    justify-content: center;
    margin: 0 0 1px 1px;
    padding-inline: clamp(8px, 1vw, 14px);
    container-type: inline-size;
    background: var(--color-campo);
  }
  .hc-h1::before {
    content: "";
    position: absolute;
    inset: -2px -1px -1px -2px;
    border: 2px solid var(--color-rojo);
    pointer-events: none;
  }
  .hc-h1::after {
    content: "";
    position: absolute;
    top: 0;
    right: 0;
    border-top: 11px solid var(--color-rojo);
    border-left: 11px solid transparent;
  }
  .hc-asa-relleno {
    position: absolute;
    right: -5px;
    bottom: -5px;
    width: 8px;
    height: 8px;
    background: var(--color-rojo);
    box-shadow: 0 0 0 1.5px var(--color-campo);
  }
  /* Both lines are 6.41em wide at these two widths of the axis. */
  .hc-l1,
  .hc-l2 {
    display: block;
    font-size: min(calc(100cqi / 6.55), calc(var(--row) * var(--h1-n) / 1.85));
    font-weight: 900;
    line-height: 0.86;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--color-tinta);
  }
  .hc-l1 {
    font-variation-settings:
      "wdth" 91,
      "wght" 900;
  }
  .hc-l2 {
    margin-top: 0.05em;
    font-variation-settings:
      "wdth" 62,
      "wght" 900;
  }

  /* ── ICP: the copied range, with marching ants ── */
  .hc-icp {
    display: flex;
    grid-column: var(--icp-c);
    grid-row: var(--icp-r);
    align-items: center;
    margin: 0 0 1px 1px;
    padding-inline: 10px;
    background: var(--color-campo);
    font-size: min(clamp(15px, 1.45vw, 21px), calc(var(--row) * 0.72));
    font-weight: 700;
    line-height: 1.22;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  .hc-icp::before {
    content: "";
    position: absolute;
    inset: -1px 0 0 -1px;
    --h: var(--color-tinta);
    background:
      linear-gradient(90deg, var(--h) 50%, transparent 0) 0 0 / 8px 1.5px
        repeat-x,
      linear-gradient(90deg, var(--h) 50%, transparent 0) 0 100% / 8px 1.5px
        repeat-x,
      linear-gradient(0deg, var(--h) 50%, transparent 0) 0 0 / 1.5px 8px
        repeat-y,
      linear-gradient(0deg, var(--h) 50%, transparent 0) 100% 0 / 1.5px 8px
        repeat-y;
    animation: hc-hormigas 0.5s linear 1.4s 12;
    pointer-events: none;
  }
  @keyframes hc-hormigas {
    to {
      background-position:
        8px 0,
        -8px 100%,
        0 -8px,
        100% 8px;
    }
  }

  .hc-bajada {
    grid-column: var(--baj-c);
    grid-row: var(--baj-r);
    align-self: center;
    margin: 0 0 1px 1px;
    padding-inline: 10px;
    background: var(--color-campo);
    font-size: min(clamp(14px, 1.2vw, 17px), calc(var(--row) * 0.68));
    line-height: 1.42;
    color: var(--color-tinta);
  }

  /* ── CTAs ── */
  .hc-ctas {
    display: flex;
    grid-column: var(--cta-c);
    grid-row: var(--cta-r);
    align-items: center;
    gap: 8px;
  }
  .hc-boton {
    cursor: pointer;
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    gap: 7px;
    padding-inline: 11px;
    border-radius: 2px;
    font-size: 14.5px;
    font-weight: 700;
    white-space: nowrap;
    transition:
      background-color 0.18s,
      border-color 0.18s,
      color 0.18s,
      transform 0.12s;
  }
  .hc-boton:active {
    transform: translateY(1px);
  }
  .hc-boton svg {
    width: 18px;
    height: 18px;
    flex: none;
  }
  .hc-boton-1 {
    flex: 1 1 auto;
    background: var(--color-rojo2);
    color: #fff;
  }
  .hc-boton-1:hover {
    background: var(--color-tinta);
  }
  .hc-boton-2 {
    border: 1.5px solid var(--color-tinta);
    background: var(--color-campo);
    color: var(--color-tinta);
  }
  .hc-boton-2:hover {
    background: var(--color-papel2);
  }

  /* ── the cell note ── */
  .hc-nota {
    grid-column: var(--nota-c);
    grid-row: var(--nota-r);
    align-self: start;
    justify-self: start;
    width: calc(var(--col) * 2.5);
    z-index: 3 !important;
    margin: 0 0 0 10px;
    padding: 10px 12px 12px;
    border: 1px solid var(--color-tinta);
    background: var(--color-papel);
    box-shadow:
      0 1px 2px rgba(22, 23, 26, 0.12),
      0 18px 32px -20px rgba(22, 23, 26, 0.55);
  }
  .hc-conector {
    position: absolute;
    display: none;
    overflow: visible;
    stroke: var(--color-tinta);
    stroke-width: 1;
  }
  .hc-palabra {
    font-family: var(--font-slab);
    font-size: 17px;
    line-height: 1.05;
  }
  .hc-cat {
    margin-left: 3px;
    font-family: var(--font-arch);
    font-size: 12.5px;
    font-style: italic;
    color: var(--color-gris);
  }
  .hc-acepciones {
    margin-top: 8px;
    font-size: 12.5px;
    line-height: 1.38;
    text-wrap: pretty;
  }
  .hc-acepcion {
    display: flex;
    gap: 6px;
  }
  .hc-acepcion + .hc-acepcion {
    margin-top: 6px;
  }
  .hc-num {
    flex: none;
    font-family: var(--font-slab);
    font-size: 11px;
    line-height: 1.6;
    color: var(--color-rojo2);
  }
  .hc-rotulo {
    color: var(--color-gris);
  }
  .hc-def :global(b) {
    font-weight: 800;
  }
  .hc-menor {
    display: none;
  }
  .hc-estrella {
    margin-top: 9px !important;
    padding-top: 8px;
    border-top: 1px solid var(--borde);
  }
  .hc-estrella .hc-rotulo {
    display: block;
    font-size: 12px;
  }
  .hc-estrella .hc-def {
    display: block;
    margin-top: 1px;
    font-size: 18px;
    font-weight: 800;
    line-height: 1.12;
    letter-spacing: -0.01em;
    text-decoration: underline wavy var(--color-rojo);
    text-decoration-thickness: 1.5px;
    text-underline-offset: 4px;
    text-decoration-skip-ink: none;
  }

  /* ── the pasted picture ── */
  .hc-foto {
    cursor: move;
    grid-column: var(--foto-c);
    grid-row: var(--foto-r);
    z-index: 2 !important;
    margin: 2px 0 calc(var(--row) * 0.2) calc(var(--col) * 0.55);
    outline: 1px solid var(--color-gris);
    box-shadow:
      0 2px 4px rgba(22, 23, 26, 0.2),
      0 26px 44px -26px rgba(22, 23, 26, 0.6);
  }
  .hc-foto-marco {
    height: 100%;
    overflow: hidden;
    background: #0d0d0f;
  }
  .hc-foto-marco :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 40%;
    transform: scale(1.22);
    transform-origin: 50% 42%;
  }
  .hc-asa {
    position: absolute;
    width: 9px;
    height: 9px;
    margin: -4.5px 0 0 -4.5px;
    border: 1.25px solid var(--color-gris);
    border-radius: 50%;
    background: var(--color-campo);
  }
  .hc-asa-nw,
  .hc-asa-w,
  .hc-asa-sw {
    left: 0;
  }
  .hc-asa-n,
  .hc-asa-s {
    left: 50%;
  }
  .hc-asa-ne,
  .hc-asa-e,
  .hc-asa-se {
    left: 100%;
  }
  .hc-asa-nw,
  .hc-asa-n,
  .hc-asa-ne {
    top: 0;
  }
  .hc-asa-w,
  .hc-asa-e {
    top: 50%;
  }
  .hc-asa-sw,
  .hc-asa-s,
  .hc-asa-se {
    top: 100%;
  }
  .hc-giro {
    position: absolute;
    top: -24px;
    left: 50%;
    display: none;
    width: 16px;
    height: 16px;
    margin-left: -8px;
    place-items: center;
    color: var(--color-gris);
  }
  .hc-giro svg {
    width: 15px;
    height: 15px;
  }

  /* ── totals that never match ── */
  .hc-cuadre {
    display: none;
