---
import { Image } from "astro:assets";
import { wa } from "@config";
import { copia } from "@data/landing";
import { heroH } from "@data/heroes/h";
import { routes, type Lang } from "@i18n/ui";
import fotoSalo from "@assets/site/fotoSaloAlta.jpg";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = copia(lang).hero;
const cta = copia(lang).cta;
const h = heroH[lang];

function partir(acepcion: string) {
  const corte = acepcion.indexOf(": ");
  if (corte < 0) return { dicho: "", resto: acepcion };
  return {
    dicho: acepcion.slice(0, corte + 1),
    resto: acepcion.slice(corte + 2),
  };
}

const acepciones = c.dicc.acepciones.map(partir);
const ultima = acepciones.length - 1;
const [antesOferta, despuesOferta] = c.bajada.includes(h.oferta)
  ? c.bajada.split(h.oferta)
  : [c.bajada, undefined];
---

<section class="hh" aria-labelledby="hh-titulo">
  <div class="hoja hh-rejilla">
    <div class="hh-texto">
      <h1 id="hh-titulo" class="hh-h1" data-mide="h1">
        <span>{c.linea1}</span>
        <span class="hh-l2">{c.linea2}</span>
      </h1>
      <p class="hh-icp" data-mide="icp">{h.icp}</p>

      <div class="hh-abajo">
        {
          despuesOferta === undefined ? (
            <p class="hh-bajada">{c.bajada}</p>
          ) : (
            <p class="hh-bajada">
              {antesOferta}
              <strong>{h.oferta}</strong>
              {despuesOferta}
            </p>
          )
        }
        <div class="hh-ctas" data-pliegue data-mide="ctas">
          <a
            class="hh-btn hh-btn--1"
            href={routes.cuentame[lang]}
            data-origen="hero"
            ><span>{cta.cuestionario}</span><svg
              class="hh-flecha"
              aria-hidden="true"><use href="#i-arw"></use></svg
            ></a
          >
          <a
            class="hh-btn hh-btn--2"
            href={wa(cta.waTexto)}
            target="_blank"
            rel="noopener"
            data-origen="hero"
            ><svg aria-hidden="true"><use href="#i-chat"></use></svg><span
              >{cta.wa}</span
            ></a
          >
        </div>
      </div>
    </div>

    <div class="hh-visual">
      <div class="hh-foto" data-mide="foto">
        <Image
          src={fotoSalo}
          widths={[360, 520, 667]}
          sizes="(min-width: 1024px) 592px, (min-width: 768px) 50vw, 100vw"
          alt={c.fichaAlt}
          loading="eager"
          fetchpriority="high"
        />
      </div>

      <div class="hh-ficha">
        <p class="hh-palabra">
          <dfn>{c.dicc.palabra}</dfn>{" "}<span class="hh-cat"
            >{c.dicc.categoria}</span
          >
        </p>
        <ol class="hh-acepciones">
          {
            acepciones.map((a, i) =>
              i === ultima ? (
                <li class="hh-acep hh-acep--ultima" data-mide="acepcion-4">
                  <span class="hh-num">{i + 1}</span>
                  <span>
                    <span class="hh-dicho">{a.dicho}</span>
                    <span class="hh-remate" set:html={a.resto} />
                  </span>
                </li>
              ) : (
                <li
                  class:list={["hh-acep", i > 0 && "hh-acep--extra"]}
                  data-mide={i === 0 ? "acepcion-1" : undefined}
                >
                  <span class="hh-num">{i + 1}</span>
                  <span>
                    <span class="hh-dicho">{a.dicho}</span>{" "}
                    <span set:html={a.resto} />
                  </span>
                </li>
              )
            )
          }
        </ol>
      </div>
    </div>
  </div>
</section>

<style>
  .hh {
    --hh-nav: 103px;
    --hh-ease: cubic-bezier(0.2, 0.8, 0.2, 1);
    display: grid;
    grid-template-rows: 1fr;
    /* Past 1000px the 667×1000 portrait would be upscaled. */
    min-height: min(calc(100svh - var(--hh-nav)), 1000px);
  }

  .hh-rejilla {
    width: 100%;
    display: flex;
    flex-direction: column;
    padding-top: 16px;
    padding-bottom: 12px;
  }

  /* ── words ── */
  .hh-texto {
    container-type: inline-size;
    display: flex;
    flex-direction: column;
  }
  .hh-h1 {
    font-family: var(--font-arch);
    font-size: min(40px, 11.6cqi);
    font-weight: 600;
    font-variation-settings: "wdth" 84;
    line-height: 1.02;
    letter-spacing: -0.03em;
    color: var(--tinta);
    text-box: trim-start cap alphabetic;
  }
  .hh-h1 > span {
    display: block;
  }
  .hh-l2 {
    text-transform: lowercase;
  }
  .hh-icp {
    margin-top: 10px;
    max-width: 30ch;
    font-size: 15.5px;
    font-weight: 500;
    line-height: 1.35;
    color: var(--tinta);
    text-wrap: pretty;
  }
  .hh-bajada {
    display: none;
    margin-top: 10px;
    max-width: 46ch;
    font-size: 15px;
    line-height: 1.5;
    color: var(--gris);
    text-wrap: pretty;
  }
  .hh-bajada strong {
    font-weight: 500;
    color: var(--tinta);
  }

  /* ── actions ── */
  .hh-ctas {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 14px;
  }
  .hh-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    min-height: 46px;
    padding: 0 18px;
    border-radius: 4px;
    font-size: 15px;
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
    outline-offset: 6px;
    transition:
      background-color 200ms var(--hh-ease),
      border-color 200ms var(--hh-ease),
      transform 200ms var(--hh-ease),
      outline-offset 200ms var(--hh-ease);
  }
  .hh-btn:focus-visible {
    outline-offset: 3px;
  }
  .hh-btn svg {
    width: 17px;
    height: 17px;
    flex: none;
  }
  .hh-btn--1 {
    background: var(--rojo2);
    color: #fff;
  }
  .hh-btn--2 {
    border: 1.5px solid var(--linea2);
    color: var(--tinta);
  }
  .hh-flecha {
    transition: transform 200ms var(--hh-ease);
  }
  @media (hover: hover) and (pointer: fine) {
    .hh-btn:hover {
      transform: translateY(-1px);
      transition-duration: 140ms;
    }
    .hh-btn--1:hover {
      background: color-mix(in oklab, var(--rojo2) 86%, var(--tinta));
    }
    .hh-btn--2:hover {
      background: var(--papel2);
      border-color: var(--tinta);
    }
    .hh-btn:hover .hh-flecha {
      transform: translateX(3px);
      transition-duration: 140ms;
    }
  }
  .hh-btn:active {
    transform: translateY(1px) scale(0.985);
    transition-duration: 90ms;
  }

  /* ── portrait and the dictionary card ── */
  .hh-visual {
    position: relative;
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    margin-top: 18px;
  }
  .hh-foto {
    /* where the top of his head sits, as a share of the frame's height */
    --hh-cara: 8cqh;
    position: relative;
    flex: 1 1 auto;
    min-height: 150px;
    overflow: hidden;
    border-radius: 6px;
    background: #0a0b0e;
    container-type: size;
  }
  /* The source is 2:3 with the head top at 28% of its height (42% of its
     width). Cover scales by width on every frame wider than 2:3, so the
     offset keeps the head at --hh-cara without uncovering the bottom. */
  .hh-foto :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: 46%
      min(0px, max(calc(var(--hh-cara) - 42cqw), calc(100cqh - 149.9cqw)));
    transition: transform 600ms var(--hh-ease);
  }
  @media (hover: hover) and (pointer: fine) {
    .hh-visual:hover .hh-foto :global(img) {
      transform: scale(1.02);
    }
  }

  .hh-ficha {
    position: relative;
    z-index: 1;
    margin: -34px 10px 0;
    padding: 12px 13px 13px;
    border: 1px solid var(--linea);
    border-radius: 4px;
    background: var(--papel);
    color: var(--tinta);
  }
  .hh-palabra {
    display: flex;
    align-items: baseline;
    gap: 9px;
  }
  .hh-palabra dfn {
    font-family: var(--font-slab);
    font-size: 19px;
    font-style: normal;
    line-height: 1;
    white-space: nowrap;
  }
  .hh-cat {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--gris);
  }
  .hh-acepciones {
    display: grid;
    gap: 6px;
    margin: 9px 0 0;
    padding: 0;
    list-style: none;
    font-size: 13px;
    line-height: 1.4;
  }
  .hh-acep {
    display: grid;
    grid-template-columns: 14px 1fr;
    text-wrap: pretty;
  }
  .hh-acep--extra {
    display: none;
  }
  .hh-acep :global(b) {
    font-weight: 600;
  }
  .hh-num {
    font-weight: 600;
    color: var(--gris);
    font-variant-numeric: tabular-nums;
  }
  .hh-dicho {
    color: var(--gris);
  }
  .hh-remate {
    display: block;
    margin-top: 2px;
    font-family: var(--font-slab);
    font-size: 19px;
    line-height: 1.12;
    color: var(--rojo2);
  }

  @media (max-width: 767px) and (min-height: 780px) {
    .hh-bajada {
      display: block;
    }
  }

  /* ── split from tablet up ── */
  @media (min-width: 768px) {
    .hh {
      --hh-nav: 61px;
    }
    .hh-rejilla {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      grid-template-rows: 1fr;
      column-gap: 24px;
      padding-top: clamp(24px, 5.33svh, 48px);
      padding-bottom: clamp(24px, 7.1svh, 64px);
    }
    .hh-texto {
      grid-column: 1 / span 6;
    }
    .hh-h1 {
      font-size: min(72px, 15.2cqi);
    }
    .hh-icp {
      margin-top: 26px;
      max-width: 31ch;
      font-size: clamp(19px, 1.8vw, 26px);
      line-height: 1.3;
      letter-spacing: -0.01em;
      text-wrap: balance;
    }
    .hh-abajo {
      margin-top: 24px;
    }
    .hh-bajada {
      display: block;
      margin: 0;
      font-size: 17px;
      line-height: 1.6;
    }
    .hh-ctas {
      width: fit-content;
      gap: 10px;
      margin-top: 32px;
    }
    .hh-btn {
      min-height: 44px;
    }
    .hh-visual {
      container: hh-visual / size;
      grid-column: 7 / -1;
      margin: 0;
    }
    .hh-foto {
      --hh-cara: 5.5cqh;
      position: absolute;
      inset: 0;
      min-height: 0;
    }
    .hh-ficha {
      position: absolute;
      left: 24px;
      bottom: 24px;
      width: min(320px, calc(100% - 48px));
      margin: 0;
      padding: 18px 20px 20px;
    }
    .hh-palabra dfn {
      font-size: 24px;
    }
    .hh-acepciones {
      gap: 8px;
      margin-top: 14px;
      font-size: 14px;
      line-height: 1.42;
    }
    .hh-acep {
      grid-template-columns: 18px 1fr;
    }
    .hh-acep--extra {
      display: grid;
    }
    .hh-acep--ultima {
      margin-top: 6px;
      padding-top: 12px;
      border-top: 1px solid var(--linea);
    }
    .hh-remate {
      margin-top: 3px;
      font-size: 24px;
    }
  }

  @media (min-width: 1024px) {
    .hh-texto {
      grid-column: 1 / span 5;
    }
  }

  .hh-texto {
    container-name: hh-texto;
  }
  @container hh-texto (min-width: 470px) {
    .hh-ctas {
      flex-direction: row;
    }
  }

  /* A short frame leaves less room under his chin: the card gets wider and
     denser so it stays below the face. */
  @container hh-visual (max-height: 660px) {
    .hh-ficha {
      width: min(400px, calc(100% - 48px));
      padding: 13px 18px 14px;
    }
    .hh-palabra dfn {
      font-size: 21px;
    }
    .hh-acepciones {
      gap: 4px;
      margin-top: 9px;
      font-size: 13px;
      line-height: 1.36;
    }
    .hh-acep--ultima {
      margin-top: 3px;
      padding-top: 7px;
    }
    .hh-remate {
      margin-top: 1px;
      font-size: 21px;
    }
  }
  @container hh-visual (max-width: 400px) {
    .hh-ficha {
      left: 16px;
      bottom: 16px;
      width: calc(100% - 32px);
      padding: 16px 16px 18px;
    }
    .hh-palabra dfn {
      font-size: 21px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hh-btn,
    .hh-flecha,
    .hh-foto :global(img) {
      transition: none;
    }
    .hh-btn:hover,
    .hh-btn:active,
    .hh-btn:hover .hh-flecha,
    .hh-visual:hover .hh-foto :global(img) {
      transform: none;
    }
  }
</style>
