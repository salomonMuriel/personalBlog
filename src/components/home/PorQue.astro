---
import EncabezadoSeccion from "@components/EncabezadoSeccion.astro";
import { copia } from "@data/landing";
import type { Lang } from "@i18n/ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = copia(lang).porque;
---

<section id="porque" class="py-[clamp(3.2rem,7vw,5.6rem)]">
  <div class="hoja">
    <EncabezadoSeccion rotulo={c.rotulo} nota={c.nota} notaCh={40} />

    <h2
      class="font-arch max-w-[24ch] text-[clamp(1.9rem,4.4vw,3.4rem)] font-extrabold leading-[1.03] tracking-[-.028em] [font-stretch:104%]"
    >
      {c.titulo}
    </h2>

    <div class="mt-[clamp(2.2rem,4.5vw,3.4rem)] space-y-[clamp(2rem,4vw,3rem)]">
      {
        c.razones.map((r, i) => (
          <div class="grid grid-cols-1 gap-x-8 gap-y-3 lg:grid-cols-[3.6rem_minmax(0,1fr)_minmax(0,14rem)]">
            <span
              class:list={[
                "font-slab block select-none text-[3.1rem] leading-[.78] text-rojo",
                r.giro,
              ]}
              aria-hidden="true"
            >
              {i + 1}
            </span>
            <div class="max-w-medida">
              <h3 class="font-arch text-[clamp(1.28rem,2.6vw,1.6rem)] font-bold leading-[1.1] tracking-[-.028em] [font-stretch:100%]">
                {r.titulo}
              </h3>
              {r.parrafos.map(p => (
                <p
                  class="mt-3 text-[1.04rem] leading-[1.65] text-gris"
                  set:html={p}
                />
              ))}
            </div>
            <p
              class:list={[
                "font-pen text-[1.2rem] leading-[1.3] text-rojo2 lg:pt-3",
                r.giroNota,
              ]}
            >
              {r.manuscrita}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
