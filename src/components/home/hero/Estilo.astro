<style is:inline>
  /* Inline, ahead of the title and keyed on its id, so it is in force when the title's script measures the block. */
  /* ── title: the chores get struck, the last strike swells into the marker block ── */
  #cartel-titulo.titular-titulo {
    position: relative;
    z-index: 2;
    order: 2;
    /* Hugs the words, so hovering the portrait never replays the cycle. */
    align-self: flex-start;
    margin-top: calc(var(--img-h) * -0.055);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  #cartel-titulo .titular-l1 {
    display: block;
    white-space: nowrap;
    font-size: var(--l1);
    line-height: 0.8;
    text-transform: uppercase;
    font-stretch: 62%;
    font-variation-settings:
      "wdth" 62,
      "wght" 900;
    letter-spacing: 0.004em;
    color: var(--papel);
  }
  #cartel-titulo .titular-l2 {
    --titular-vivo: #d4d1c9;
    --titular-muerto: #64635e;
    /* The billing block's marker red: paper on it reads at 5.81:1. */
    --titular-tinta: #b3251d;
    --titular-pluma: #ea4b3e;
    position: relative;
    display: block;
    white-space: nowrap;
    /* Room above the words for the block. */
    margin-top: 0.3em;
    padding-bottom: 0;
    /* Sized so both lines lock up to the same width. */
    font-size: calc(var(--l1) * 0.466);
    line-height: 0.95;
    text-transform: uppercase;
  }
  /* «The fake-automated» is longer than «Lo chinomático»: keep it inside the column. */
  #cartel-titulo:lang(en) .titular-l2 {
    font-size: calc(var(--l1) * 0.35);
  }
  /* The block and the word on it share one clip: the chisel ends of the nib. */
  #cartel-titulo .titular-marca {
    position: relative;
    z-index: 1;
    display: block;
    isolation: isolate;
    clip-path: polygon(
      calc(100% + 0.32em) -0.3em,
      calc(100% + 0.2582em) 0.18em,
      calc(100% + 0.1334em) 0.62em,
      calc(100% + 0.04em) calc(100% + 0.3em),
      calc(0% + -0.3em) calc(100% + 0.3em),
      calc(0% + -0.2066em) 0.62em,
      calc(0% + -0.0818em) 0.18em,
      calc(0% + -0.02em) -0.3em
    );
  }
  /* A solid colour cut by the marker's wobbly outline, so the swell can shift from pen red to marker red. */
  #cartel-titulo .titular-banda {
    position: absolute;
    z-index: -1;
    inset: -0.2em -0.4em -0.04em -0.38em;
    background-color: var(--titular-tinta);
    -webkit-mask: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 400 50' preserveAspectRatio='none'><path d='M0 2.4C60 .6 130 2.6 205 1.3 280 0 345 1.2 400 2.8v44.6c-65 2.2-138 .2-210 1.4-72 1.2-132-.4-190 .4Z'/></svg>")
      center / 100% 100% no-repeat;
    mask: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 400 50' preserveAspectRatio='none'><path d='M0 2.4C60 .6 130 2.6 205 1.3 280 0 345 1.2 400 2.8v44.6c-65 2.2-138 .2-210 1.4-72 1.2-132-.4-190 .4Z'/></svg>")
      center / 100% 100% no-repeat;
    transform: rotate(-0.6deg);
  }
  #cartel-titulo .titular-reposo {
    display: block;
    letter-spacing: -0.012em;
    color: var(--papel);
  }
  /* A clipped band that ends just under the first line, so a leaving chore never touches it. */
  #cartel-titulo .titular-tramoya {
    position: absolute;
    z-index: 0;
    inset: -0.28em -0.45em -0.26em -0.3em;
    overflow: hidden;
    pointer-events: none;
    mask-image: linear-gradient(
      to bottom,
      transparent,
      #000 0.1em,
      #000 calc(100% - 0.2em),
      transparent
    );
  }
  /* Set in the slab's line box, so every chore shares the resting words' baseline. */
  #cartel-titulo .titular-frase {
    position: absolute;
    left: 0.3em;
    top: 0.28em;
    white-space: nowrap;
    visibility: hidden;
    color: var(--titular-vivo);
  }
  #cartel-titulo .titular-linea {
    font-family: var(--font-arch);
    font-size: calc(var(--titular-ajuste, 1) * 1em);
    line-height: 0.6;
    letter-spacing: 0.01em;
    font-variation-settings:
      "wdth" var(--titular-wdth, 62),
      "wght" 600;
  }
  #cartel-titulo .titular-palabra {
    display: inline-block;
  }
  /* The word that gets worse: a window as wide as the current word, the next one rolls up into it. */
  #cartel-titulo .titular-rueda {
    position: relative;
    /* From just above an accented capital down to the baseline. */
    clip-path: inset(-0.33em 0 -0.08em 0);
  }
  #cartel-titulo .titular-cifra {
    display: inline-block;
  }
  #cartel-titulo .titular-siguiente {
    position: absolute;
    top: 0;
    left: 0;
    transform: translateY(1.15em);
  }
  #cartel-titulo .titular-raya {
    position: absolute;
    left: -0.12em;
    top: 0.33em;
    width: calc(100% + 0.24em);
    height: 0.4em;
    overflow: visible;
    fill: none;
    stroke: var(--titular-pluma);
    stroke-width: 8.5;
    stroke-linecap: round;
    stroke-dasharray: 1 2;
    stroke-dashoffset: 1.02;
  }

  @media (min-width: 1024px) {
    #cartel-titulo.titular-titulo {
      margin-top: auto;
      padding-top: 24px;
    }
  }
</style>
