---
import { copia } from "@data/landing";
import type { Lang } from "@i18n/ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = copia(lang).banda;
---

<section class="bg-panel py-[clamp(2.6rem,6vw,4.6rem)] text-panelfg">
  <div class="hoja">
    <div
      class="grid grid-cols-1 items-end gap-[clamp(1.2rem,3vw,3rem)] lg:grid-cols-[minmax(0,1.35fr)_minmax(0,1fr)]"
    >
      <h2
        class="font-arch max-w-[19ch] text-[clamp(1.8rem,4.4vw,3.4rem)] font-extrabold leading-[1.04] tracking-[-.032em] [font-stretch:100%]"
      >
        {c.titulo}
      </h2>
      <div>
        <p class="max-w-[46ch] text-[1.05rem] leading-[1.55] text-paneltxt">
          {c.texto}
        </p>
        <p
          class="font-mono mt-4 text-[10.5px] uppercase tracking-[.18em] text-rojo3"
        >
          {c.rotulo}
        </p>
      </div>
    </div>
  </div>
</section>
