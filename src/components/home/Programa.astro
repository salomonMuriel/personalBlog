---
import { Image } from "astro:assets";
import EncabezadoSeccion from "@components/EncabezadoSeccion.astro";
import { copia } from "@data/landing";
import type { Lang } from "@i18n/ui";
import { ilustraciones } from "@utils/ilustraciones";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = copia(lang).programa;

// The ruler stops at week 9; the open row says the rhythm goes on from there.
const SEMANAS = 9;
const semanas = Array.from({ length: SEMANAS }, (_, i) => i + 1);
const desdeAbierta = c.filas[c.filas.length - 1].hasta + 1;
const retraso = (i: number) => `transition-delay:${(i * 0.12).toFixed(2)}s`;
---

<section
  id="programa"
  class="border-y border-linea bg-papel2 py-[clamp(3.2rem,7vw,5.6rem)]"
>
  <div class="hoja">
    <EncabezadoSeccion rotulo={c.rotulo} nota={c.nota} notaCh={42} />

    <h2
      class="font-arch max-w-[24ch] text-[clamp(1.9rem,4.4vw,3.4rem)] font-extrabold leading-[1.03] tracking-[-.028em] [font-stretch:104%]"
    >
      {c.titulo}
    </h2>

    <div
      class="observa gantt mt-[clamp(1.8rem,3.6vw,2.8rem)] grid grid-cols-[6.7rem_minmax(0,1fr)] items-center sm:grid-cols-[minmax(5.6rem,10.5rem)_minmax(0,1fr)] gap-x-[clamp(.75rem,2vw,1.5rem)] gap-y-[6px]"
    >
      <span></span>
      <div
        class="grid border-b border-linea pb-1.5"
        style={`grid-template-columns:repeat(${SEMANAS},minmax(0,1fr))`}
        aria-hidden="true"
      >
        {
          semanas.map(s => (
            <span class="font-mono text-[10.5px] text-gris">{`${c.semanaCorta}${s}`}</span>
          ))
        }
      </div>

      {
        c.filas.map((f, i) => (
          <>
            <span class="font-arch text-[.9rem] font-bold leading-tight sm:text-[.98rem] tracking-[-.01em]">
              {f.nombre}
            </span>
            <div
              class="pista grid items-center"
              style={`grid-template-columns:repeat(${SEMANAS},minmax(0,1fr))`}
            >
              <div
                class:list={[
                  "barra flex h-9 items-center justify-end rounded px-1.5",
                  f.entrega ? "bg-tinta" : "bg-linea",
                ]}
                style={`grid-column:${f.desde} / ${f.hasta + 1};${retraso(i)}`}
              >
                {f.entrega && (
                  <span class="grid h-6 w-6 place-items-center rounded-[2px] bg-rojo2 text-white">
                    <svg class="h-3.5 w-3.5" aria-hidden="true">
                      <use href="#i-check" />
                    </svg>
                  </span>
                )}
              </div>
              {i === 1 && (
                <span
                  class="font-pen pl-2 text-[clamp(1rem,2vw,1.3rem)] leading-[1.05] text-rojo2"
                  style={`grid-column:${f.hasta + 1} / -1`}
                >
                  ← {c.notaPrimera}
                </span>
              )}
            </div>
          </>
        ))
      }

      <span
        class="font-arch text-[.9rem] font-bold leading-tight sm:text-[.98rem] tracking-[-.01em] text-gris"
      >
        {c.filaAbierta}
      </span>
      <div
        class="pista grid items-center"
        style={`grid-template-columns:repeat(${SEMANAS},minmax(0,1fr))`}
      >
        <div
          class="barra abierta h-9 rounded-l border-[1.5px] border-r-0 border-dashed border-linea2 bg-linea/50"
          style={`grid-column:${desdeAbierta} / -1;${retraso(c.filas.length)}`}
          aria-hidden="true"
        >
        </div>
      </div>
    </div>

    <div
      class="mt-[clamp(2.4rem,5vw,4rem)] grid grid-cols-1 items-center gap-[clamp(1.6rem,4vw,3.5rem)] lg:grid-cols-[minmax(0,1fr)_minmax(0,1.05fr)]"
    >
      <div>
        <ol class="border-t border-linea">
          {
            c.etapas.map(e => (
              <li class="border-b border-linea py-4">
                <div class="flex items-baseline justify-between gap-4">
                  <h3 class="font-arch text-[1.15rem] font-bold leading-tight tracking-[-.02em]">
                    {e.titulo}
                  </h3>
                  <span class="font-mono flex-none text-[11px] uppercase tracking-[.14em] text-rojo2">
                    {e.cuando}
                  </span>
                </div>
                <p class="mt-1.5 text-[1rem] leading-[1.5] text-gris">
                  {e.texto}
                </p>
              </li>
            ))
          }
        </ol>

        <div class="mt-6 border-l-[3px] border-rojo pl-4">
          <p
            class="font-mono text-[11px] font-semibold uppercase tracking-[.18em] text-rojo2"
          >
            {c.garantiaRotulo}
          </p>
          <p
            class="font-arch mt-1.5 max-w-[34ch] text-[clamp(1.2rem,2.4vw,1.55rem)] font-bold leading-[1.2] tracking-[-.028em] [font-stretch:98%]"
          >
            {c.garantia}
          </p>
        </div>
      </div>

      <div
        class="mx-auto w-full max-w-[34rem] rounded border border-linea bg-campo p-[7px] lg:max-w-none"
      >
        <Image
          src={ilustraciones["una-cajita"]}
          widths={[480, 720, 1080]}
          sizes="(min-width:1024px) 48vw, 92vw"
          loading="lazy"
          alt={c.alt}
          class="aspect-[5/4] h-auto w-full rounded-[1px] object-cover"
        />
      </div>
    </div>
  </div>
</section>

<style>
  /* Faint week lines behind the bars. */
  .pista {
    background-image: linear-gradient(
      to right,
      var(--color-linea) 1px,
      transparent 1px
    );
    background-size: calc(100% / 9) 100%;
  }
  .abierta {
    mask-image: linear-gradient(to right, #000 55%, transparent);
  }
</style>
