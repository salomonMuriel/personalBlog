---
import Hero from "@components/home/Hero.astro";
import Cinta from "@components/home/Cinta.astro";
import Clientes from "@components/home/Clientes.astro";
import Danos from "@components/home/Danos.astro";
import TableroCajitas from "@components/home/TableroCajitas.astro";
import Sistemas from "@components/home/Sistemas.astro";
import BandaEjecucion from "@components/home/BandaEjecucion.astro";
import PorQue from "@components/home/PorQue.astro";
import Programa from "@components/home/Programa.astro";
import Entrega from "@components/home/Entrega.astro";
import AntesDeEsto from "@components/home/AntesDeEsto.astro";
import Testimonios from "@components/home/Testimonios.astro";
import Faq from "@components/home/Faq.astro";
import BarraMovil from "@components/home/BarraMovil.astro";
import { preguntasEs, preguntasEn } from "@data/preguntas";
import type { Lang } from "@i18n/ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const preguntas = lang === "es" ? preguntasEs : preguntasEn;
---

<Hero lang={lang} />
<Cinta lang={lang} />
<Clientes lang={lang} />
<Danos lang={lang} />
<TableroCajitas lang={lang} />
<Sistemas lang={lang} />
<BandaEjecucion lang={lang} />
<PorQue lang={lang} />
<Programa lang={lang} />
<Entrega lang={lang} />
<AntesDeEsto lang={lang} />
<Testimonios lang={lang} />
<Faq lang={lang} preguntas={preguntas} />
<BarraMovil lang={lang} />
