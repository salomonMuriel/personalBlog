---
import { Image } from "astro:assets";
import EncabezadoSeccion from "@components/EncabezadoSeccion.astro";
import { copia } from "@data/landing";
import type { Lang } from "@i18n/ui";
import saloOscar from "@assets/site/salo_oscar.webp";
import ignia from "@assets/site/ignia.png";
import finco from "@assets/site/finco.png";
import prestagente from "@assets/site/prestagente.png";
import beriblock from "@assets/site/beriblock.png";
import elpalomo from "@assets/site/elpalomo.png";

interface Props {
  lang: Lang;
  /** En el home la lista cierra apuntando a #cupos; en /sobre-mi no. */
  cierre?: boolean;
}
const { lang, cierre = true } = Astro.props;
const c = copia(lang).montado;

const logos: Record<string, ImageMetadata | undefined> = {
  ignia,
  finco,
  prestagente,
  beriblock,
  elpalomo,
};
---

<section
  id="montado"
  class="border-y border-linea bg-papel2 py-[clamp(3.2rem,7vw,5.6rem)]"
>
  <div class="hoja">
    <EncabezadoSeccion rotulo={c.rotulo} nota={c.nota} notaCh={42} />

    <h2
      class="font-arch max-w-[20ch] text-[clamp(1.9rem,4.4vw,3.4rem)] font-extrabold leading-[1.03] tracking-[-.028em] [font-stretch:104%]"
    >
      {c.titulo}
    </h2>

    <div
      class="mt-[clamp(1.8rem,3.6vw,2.8rem)] grid grid-cols-1 items-start gap-[clamp(1.5rem,4vw,3.5rem)] lg:grid-cols-[minmax(0,1fr)_minmax(0,1.12fr)]"
    >
      <figure class="m-0">
        <div class="rounded border border-linea bg-campo p-[9px]">
          <Image
            src={saloOscar}
            widths={[420, 840, 1052]}
            sizes="(min-width:1024px) 46vw, 92vw"
            loading="lazy"
            alt={c.fotoAlt}
            class="h-auto w-full rounded-[1px] [filter:grayscale(.18)_contrast(1.04)]"
          />
        </div>
        <figcaption class="mt-3 text-[13.5px] leading-[1.45] text-gris">
          {c.pieFoto}
        </figcaption>
      </figure>

      <div class="border-t border-linea">
        {
          c.empresas.map(e => (
            <article class="grid grid-cols-[54px_minmax(0,1fr)] items-start gap-4 border-b border-linea py-4">
              <div class="grid h-[54px] w-[54px] place-items-center rounded border border-linea bg-white p-2">
                {logos[e.clave] ? (
                  <Image
                    src={logos[e.clave]!}
                    width={72}
                    densities={[1, 2]}
                    alt={`Logotipo de ${e.nombre}`}
                    loading="lazy"
                    class="h-full w-full object-contain"
                  />
                ) : (
                  <span class="font-mono text-[13px] font-semibold">
                    {e.nombre}
                  </span>
                )}
              </div>
              <div>
                <p class="font-arch text-[1.14rem] font-extrabold leading-none tracking-[-.02em]">
                  {e.nombre}
                  <span class="font-mono ml-1 text-[10.5px] font-normal tracking-[.1em] text-gris">
                    {e.cuando}
                  </span>
                </p>
                {/* set:html porque los tres trozos van pegados: con saltos
                    de línea Astro metería espacios antes de los puntos. */}
                <p
                  class="mt-1.5 max-w-[46ch] text-[.95rem] leading-[1.5] text-gris"
                  set:html={
                    e.texto +
                    ("remate" in e && e.remate
                      ? ` <b class="font-semibold ${e.remateRojo ? "text-rojo2" : "text-tinta"}">${e.remate}</b>`
                      : "") +
                    ("cola" in e && e.cola ? e.cola : "")
                  }
                />
              </div>
            </article>
          ))
        }

        {
          cierre && (
            <>
              <p
                class="mt-5 max-w-[52ch] text-[1.02rem] leading-[1.6]"
                set:html={`${c.cierre1a}<a href="#cupos" class="border-b-[1.5px] border-current font-semibold text-rojo2 transition-colors hover:text-tinta">${c.cierreEnlace}</a>${c.cierre1b}`}
              />
              <p class="mt-3 max-w-[52ch] text-[.96rem] leading-[1.55] text-gris">
                {c.cierre2}
              </p>
            </>
          )
        }
      </div>
    </div>
  </div>
</section>
