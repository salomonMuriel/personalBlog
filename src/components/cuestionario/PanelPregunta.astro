---
import {
  MULTIPLES,
  OPCIONES,
  ORDEN,
  type ClavePregunta,
} from "@data/cuestionario/opciones";
import type { CopiaCuestionario } from "@data/cuestionario/tipos";

interface Props {
  copia: CopiaCuestionario;
  total: number;
}
const { copia: c, total } = Astro.props;

const ayudaDe = (clave: ClavePregunta) => {
  const max = MULTIPLES[clave];
  if (!max) return undefined;
  return max < OPCIONES[clave].length
    ? c.escogeHasta.replace("%n", String(max))
    : c.marcaVarias;
};
const pasos = [
  ...ORDEN.map(clave => ({
    id: clave,
    titulo: c.preguntas[clave].titulo,
    ayuda: ayudaDe(clave),
  })),
  { id: "contacto", titulo: c.contacto.titulo, ayuda: undefined },
];
---

<div
  data-cabecera
  class="rounded bg-panel px-4 pb-3.5 pt-3 text-panelfg sm:px-6 sm:pb-6 sm:pt-5 lg:min-h-[300px] lg:px-8 lg:pb-8 lg:pt-7"
>
  <div class="flex items-center justify-between gap-4">
    <p
      class="font-mono hidden text-[11px] font-semibold uppercase tracking-[.2em] text-rojo3 sm:block"
    >
      {c.titulo}
    </p>
    <p
      data-paso-texto
      data-plantilla={c.paso}
      aria-live="polite"
      class="font-mono text-[11px] uppercase tracking-[.14em] text-panelnota"
    >
      {c.paso.replace("%n", "1").replace("%t", String(total))}
    </p>
  </div>

  <div class="mt-2 flex gap-1" aria-hidden="true" data-segmentos>
    {
      Array.from({ length: total }).map((_, i) => (
        <span
          data-segmento={i}
          class:list={[
            "h-[3px] flex-1 transition-colors duration-300 motion-reduce:transition-none",
            i === 0 ? "bg-rojo3" : "bg-panelborde",
          ]}
        />
      ))
    }
  </div>

  {
    pasos.map((p, i) => (
      <div data-titulo={p.id} hidden={i > 0} class="mt-3 sm:mt-6">
        <h1
          id={`titulo-${p.id}`}
          tabindex="-1"
          class="font-arch text-[clamp(1.15rem,2.8vw,2.1rem)] font-extrabold leading-[1.12] tracking-[-.028em] outline-none [font-stretch:100%]"
        >
          {p.titulo}
        </h1>
        {p.ayuda && (
          <p class="mt-1 text-[14px] text-paneltxt sm:mt-2">{p.ayuda}</p>
        )}
      </div>
    ))
  }

  <slot name="pie" />
</div>
