---
import { wa } from "@config";
import { copiaCuestionario, ORDEN } from "@data/cuestionario";
import type { Lang } from "@i18n/ui";
import PasoOpciones from "./PasoOpciones.astro";
import PasoContacto from "./PasoContacto.astro";
import Resultado from "./Resultado.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = copiaCuestionario(lang);
const total = ORDEN.length + 1;
const datos = JSON.stringify(c).replace(/</g, "\\u003c");
---

<section class="pb-[clamp(2rem,5vw,4rem)] pt-[clamp(.5rem,2.4vw,2rem)]">
  <div class="hoja">
    <div
      data-cuestionario
      data-idioma={lang}
      data-version="v1"
      class="-mx-[clamp(1.25rem,4vw,3.5rem)] max-w-[52rem] border-y-[1.5px] border-linea2 bg-campo sm:mx-0 sm:rounded sm:border-x-[1.5px] sm:shadow-[0_1px_0_rgba(22,23,26,.05),0_16px_36px_-28px_rgba(22,23,26,.55)]"
    >
      <div
        data-cabecera
        class="border-b border-linea px-4 pb-3 pt-3.5 sm:px-6 sm:pb-4 sm:pt-5"
      >
        <p
          class="font-mono hidden text-[11px] font-semibold uppercase tracking-[.2em] sm:block"
        >
          {c.rotulo}
        </p>
        <div class="flex items-baseline justify-between gap-4 sm:mt-1.5">
          <h1
            class="font-arch text-[clamp(1.15rem,2.6vw,1.75rem)] font-extrabold leading-[1.1] tracking-[-.025em] [font-stretch:100%]"
          >
            {c.titulo}
          </h1>
          <p
            data-paso-texto
            data-plantilla={c.paso}
            aria-live="polite"
            class="font-mono flex-none text-[11px] font-medium uppercase tracking-[.14em] text-gris"
          >
            {c.paso.replace("%n", "1").replace("%t", String(total))}
          </p>
        </div>
        <p class="mt-1.5 hidden max-w-[60ch] text-[14px] text-gris sm:block">
          {c.nota}
        </p>
        <div
          class="mt-3 h-[3px] w-full overflow-hidden bg-linea"
          aria-hidden="true"
        >
          <div
            data-barra
            class="h-full bg-rojo transition-[width] duration-300 ease-out motion-reduce:transition-none"
            style={`width:${100 / total}%`}
          >
          </div>
        </div>
      </div>

      <form data-formulario novalidate class="px-4 pt-4 sm:px-6 sm:pt-6">
        {
          ORDEN.map((clave, i) => (
            <PasoOpciones clave={clave} indice={i} copia={c} />
          ))
        }
        <PasoContacto copia={c} />

        <div
          class="sticky bottom-0 z-10 -mx-4 mt-4 flex items-center justify-between gap-3 border-t border-linea bg-campo px-4 py-2.5 sm:static sm:mx-0 sm:mt-6 sm:border-0 sm:px-0 sm:pb-6 sm:pt-0"
        >
          <button
            type="button"
            data-atras
            hidden
            class="inline-flex items-center gap-2 rounded px-1 py-3 text-[.95rem] font-semibold text-gris transition-colors hover:text-tinta"
          >
            <svg class="h-4 w-4 rotate-180" aria-hidden="true"
              ><use href="#i-arw"></use></svg
            >{c.atras}
          </button>
          <span class="flex-1"></span>
          <button
            type="button"
            data-siguiente
            class="inline-flex items-center gap-2.5 rounded bg-tinta px-5 py-3.5 text-[.97rem] font-bold text-papel transition-[background-color,transform,opacity] hover:bg-rojo2 active:translate-y-px disabled:pointer-events-none disabled:opacity-35"
          >
            {c.siguiente}<svg
              class="h-[18px] w-[18px] opacity-80"
              aria-hidden="true"><use href="#i-arw"></use></svg
            >
          </button>
          <button
            type="submit"
            data-enviar
            data-texto-enviando={c.contacto.enviando}
            hidden
            class="inline-flex items-center gap-2.5 rounded bg-rojo2 px-5 py-3.5 text-[.97rem] font-bold text-white transition-[background-color,transform] hover:bg-tinta active:translate-y-px disabled:opacity-60"
          >
            {c.contacto.enviar}<svg
              class="h-[18px] w-[18px] opacity-80"
              aria-hidden="true"><use href="#i-arw"></use></svg
            >
          </button>
        </div>
      </form>

      <Resultado copia={c} lang={lang} />

      <noscript>
        <p class="px-5 pb-6 text-[1rem] sm:px-6">
          <a
            href={wa(c.wa.encabezado)}
            class="border-b-[1.5px] border-current font-semibold text-rojo2"
            >WhatsApp</a
          >
        </p>
      </noscript>
    </div>
  </div>
</section>

<script
  type="application/json"
  id="cuestionario-copia"
  is:inline
  set:html={datos}
/>

<script>
  import { iniciarCuestionario } from "./cuestionario.client";
  iniciarCuestionario();
</script>
