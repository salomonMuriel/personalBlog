---
import { copiaFicha } from "@data/ficha";
import type { Lang } from "@i18n/ui";
import Titulo from "./Titulo.astro";
import Etiqueta from "./Etiqueta.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = copiaFicha(lang).charlas;
---

<Titulo
  rotulo={c.rotulo}
  nota={c.nota}
  titulo={c.titulo}
  manuscrita={c.manuscrita}
/>

<div class="border-linea mt-4 border-t">
  {
    c.temas.map(t => (
      <article class="border-linea grid grid-cols-1 gap-x-5 gap-y-1 border-b py-2.5 sm:grid-cols-[2rem_minmax(0,1.7fr)_minmax(0,1fr)]">
        <span class="text-rojo2 pt-1 font-mono text-[10px] tracking-[.16em]">
          {t.n}
        </span>
        <div>
          <h3 class="font-arch text-[16.5px] leading-[1.18] font-bold tracking-[-.02em]">
            {t.t}
          </h3>
          <p class="text-gris mt-1 text-[12.5px] leading-[1.45]">{t.d}</p>
        </div>
        <p class="text-gris font-mono text-[9px] leading-[1.7] tracking-[.12em] uppercase sm:pt-1">
          {t.publico}
        </p>
      </article>
    ))
  }
</div>

<div
  class="mt-3.5 grid grid-cols-1 gap-4 sm:grid-cols-[minmax(0,1.25fr)_minmax(0,1fr)]"
>
  <div class="bg-tinta text-panelfg rounded px-4 py-3.5">
    <Etiqueta class="text-rojo3">{c.talleresT}</Etiqueta>
    <p class="mt-1.5 text-[13px] leading-[1.5]">{c.talleres}</p>
    <ul class="mt-2.5 space-y-2">
      {
        c.talleresEjemplos.map(e => (
          <li class="text-paneltxt flex gap-2.5 text-[12.5px] leading-[1.45]">
            <svg
              class="text-rojo3 mt-[2px] h-[13px] w-[13px] flex-none"
              aria-hidden="true"
            >
              <use href="#i-check" />
            </svg>
            <span>{e}</span>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="border-linea2 bg-campo rounded border-[1.5px] px-4 py-3.5">
    <Etiqueta>{c.formatosT}</Etiqueta>
    <dl class="mt-1.5">
      {
        c.formatos.map(([k, v], i) => (
          <div
            class:list={[
              "py-[4px]",
              i < c.formatos.length - 1 && "border-linea border-b",
            ]}
          >
            <dt class="text-[13px] leading-[1.3] font-bold">{k}</dt>
            <dd class="text-gris text-[12px] leading-[1.4]">{v}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</div>

<div class="mt-auto pt-3.5">
  <Etiqueta class="border-tinta mb-1.5 border-t-[1.5px] pt-2.5"
    >{c.recientesT}</Etiqueta
  >
  <table class="w-full text-left text-[12.5px] leading-[1.35]">
    <tbody>
      {
        c.recientes.map(([anio, titulo, donde]) => (
          <tr class="border-linea border-b align-baseline">
            <td class="text-gris w-[3.4rem] py-[5px] font-mono text-[10px] tracking-[.12em]">
              {anio}
            </td>
            <td class="py-[5px] pr-3 font-semibold">{titulo}</td>
            <td class="text-gris py-[5px] text-right">{donde}</td>
          </tr>
        ))
      }
    </tbody>
  </table>

  <Etiqueta class="mt-3 mb-2">{c.tarimasT}</Etiqueta>
  <ul class="flex flex-wrap gap-1.5">
    {
      c.tarimas.map(x => (
        <li class="border-linea2 bg-campo rounded border px-2 py-[5px] font-mono text-[9px] tracking-[.12em] uppercase">
          {x}
        </li>
      ))
    }
  </ul>
</div>
