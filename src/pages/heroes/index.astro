---
import Layout from "@layouts/Layout.astro";
import { variantes } from "@components/home/heroes";

export const prerender = true;

const conceptos: Record<(typeof variantes)[number], string> = {
  a: "Cartel nocturno (referencia)",
  f: "La palabra que cambia (referencia)",
  g: "Tríptico con sistemas (referencia)",
  a1: "Cartel con palabras, tríptico en la vitrina de sistemas",
  a2: "Cartel con palabras y tríptico en el hero",
  a3: "Cartel con palabras y cinta de pantallas",
};
---

<Layout
  title="Versiones del hero"
  description="Versiones del hero para comparar."
  lang="es"
  noindex
  enfoque
>
  <section class="hoja py-12">
    <h1 class="font-arch text-4xl font-black uppercase">Versiones del hero</h1>
    <ol class="mt-8 divide-y divide-linea border-y border-linea">
      <li>
        <a href="/" class="flex items-baseline gap-4 py-4 hover:text-rojo2"
          ><span class="font-mono w-8 text-sm uppercase text-gris">hoy</span
          ><span class="text-lg font-semibold">El hero actual</span></a
        >
      </li>
      {
        variantes.map(v => (
          <li>
            <a
              href={`/heroes/${v}/`}
              class="flex items-baseline gap-4 py-4 hover:text-rojo2"
            >
              <span class="font-mono w-8 text-sm uppercase text-gris">{v}</span>
              <span class="text-lg font-semibold">{conceptos[v]}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </section>
</Layout>
