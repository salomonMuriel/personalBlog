---
import Layout from "@layouts/Layout.astro";
import Landing from "@components/home/Landing.astro";
import { conTriptico, variantes, type Variante } from "@components/home/heroes";
import { copia } from "@data/landing";

export const prerender = true;

export function getStaticPaths() {
  return variantes.map(variante => ({ params: { variante } }));
}

const variante = Astro.params.variante as Variante;
const c = copia("es").meta;
---

<Layout
  title={`Hero ${variante.toUpperCase()} · ${c.title}`}
  description={c.description}
  lang="es"
  navHome="#arriba"
  noindex
>
  <Landing
    lang="es"
    hero={variante}
    vitrina={conTriptico.includes(variante) ? "triptico" : "galerias"}
  />
</Layout>
