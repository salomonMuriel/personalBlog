---
import Layout from "@layouts/Layout.astro";
import Cuestionario from "@components/cuestionario/Cuestionario.astro";
import { copiaCuestionario } from "@data/cuestionario";

export const prerender = true;

const c = copiaCuestionario("es");
---

<Layout
  title={c.meta.title}
  description={c.meta.description}
  lang="es"
  noindex
  sinContacto
>
  <Cuestionario lang="es" />
</Layout>
