---
import Layout from "@layouts/Layout.astro";
import Landing from "@components/home/Landing.astro";
import { copia } from "@data/landing";
import { preguntasEs } from "@data/preguntas";
import { servicioLd, faqLd } from "@utils/jsonld";

export const prerender = true;

const c = copia("es").meta;
---

<Layout
  title={c.title}
  description={c.description}
  lang="es"
  navHome="#arriba"
  schemas={[servicioLd("es"), faqLd(preguntasEs)]}
>
  <Landing lang="es" />
</Layout>
