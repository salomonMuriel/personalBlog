---
import Layout from "@layouts/Layout.astro";
import Cuestionario from "@components/cuestionario/Cuestionario.astro";
import { copiaCuestionario } from "@data/cuestionario";

export const prerender = true;

const c = copiaCuestionario("en");
---

<Layout
  title={c.meta.title}
  description={c.meta.description}
  lang="en"
  noindex
  enfoque
>
  <Cuestionario lang="en" />
</Layout>
