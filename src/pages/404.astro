---
import Layout from "@layouts/Layout.astro";
import { routes } from "@i18n/ui";

export const prerender = true;

const paginas = [
  { href: routes.home.es, es: "Consultoría", en: "Consulting" },
  { href: routes.mentoria.es, es: "Mentoría", en: "Mentoring" },
  { href: routes.charlas.es, es: "Charlas", en: "Talks" },
  { href: routes.sobreMi.es, es: "Sobre mí", en: "About" },
  { href: routes.ahora.es, es: "Ahora", en: "Now" },
];
---

<Layout
  title="Página no encontrada — Salomón Muriel"
  description="Esta página no existe. Acá está lo que sí."
  lang="es"
  noindex
>
  <section class="py-[clamp(3.2rem,7vw,5.6rem)]">
    <div class="hoja">
      <div
        class="mb-[clamp(1.8rem,3.6vw,2.8rem)] flex flex-col gap-x-6 gap-y-1 border-t-[2.5px] border-tinta pt-3 sm:flex-row sm:items-baseline"
      >
        <span
          class="font-mono whitespace-nowrap text-[11px] font-semibold uppercase tracking-[.2em]"
          >Error 404</span
        >
        <span
          class="max-w-[40ch] text-[13px] leading-[1.35] text-gris sm:ml-auto sm:text-right"
          >El enlace se rompió o la página se retiró.</span
        >
      </div>

      <h1
        class="font-arch max-w-[16ch] text-[clamp(2.4rem,7vw,4.4rem)] font-black uppercase leading-[.9] tracking-[-.02em] [font-stretch:70%]"
      >
        Acá no hay nada
      </h1>
      <p
        class="font-pen mt-4 -rotate-[1.2deg] text-[clamp(1.2rem,3.2vw,1.6rem)] leading-[1.2] text-rojo2"
      >
        pero abajo sí
      </p>

      <ul class="mt-8 max-w-[34rem] border-t border-linea">
        {
          paginas.map((p, i) => (
            <li>
              <a
                href={p.href}
                class="group flex items-center gap-4 border-b border-linea py-4 transition-colors hover:bg-papel2"
              >
                <span class="font-mono w-7 flex-none text-[10.5px] tracking-[.16em] text-gris">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <span class="font-arch flex-1 text-[1.2rem] font-bold tracking-[-.02em]">
                  {p.es}
                </span>
                <span
                  class="flex-none text-rojo2 transition-transform duration-200 group-hover:translate-x-1.5"
                  aria-hidden="true"
                >
                  <svg class="h-5 w-5">
                    <use href="#i-arw" />
                  </svg>
                </span>
              </a>
            </li>
          ))
        }
      </ul>

      <p
        class="font-mono mt-6 text-[10.5px] uppercase leading-[1.9] tracking-[.13em] text-gris"
      >
        English · <a href="/en/" class="border-b border-current"
          >go to the English site</a
        >
      </p>
    </div>
  </section>
</Layout>
