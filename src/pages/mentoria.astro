---
import Layout from "@layouts/Layout.astro";
import Mentoria from "@components/paginas/Mentoria.astro";
import { copiaMentoria } from "@data/mentoria";
import { faqLd, breadcrumbLd } from "@utils/jsonld";
import { routes } from "@i18n/ui";

export const prerender = true;

const c = copiaMentoria("es");
---

<Layout
  title={c.meta.title}
  description={c.meta.description}
  lang="es"
  schemas={[
    faqLd([...c.preguntas]),
    breadcrumbLd([
      { name: "Inicio", url: routes.home.es },
      { name: "Mentoría", url: routes.mentoria.es },
    ]),
  ]}
>
  <Mentoria lang="es" />
</Layout>
