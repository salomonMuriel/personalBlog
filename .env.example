# ── Keystatic en producción (modo GitHub) ────────────────────────────────
# El admin vive en /keystatic. En local escribe archivos directamente y no
# necesita nada de esto; en Vercel abre un commit en GitHub a nombre de
# Salomón y sí lo necesita.
#
# Cómo obtenerlos: entre a https://www.salomonmuriel.com/keystatic desde el
# deploy, siga el flujo «set up GitHub app» y Keystatic imprime los tres
# valores para pegar en Vercel → Settings → Environment Variables.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=

# Fuerza el modo local del CMS aunque no sea `astro dev` (útil para probar
# el admin contra un build de producción en la máquina).
# KEYSTATIC_LOCAL=true

# ── Search Console ───────────────────────────────────────────────────────
PUBLIC_GOOGLE_SITE_VERIFICATION=
