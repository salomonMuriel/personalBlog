# ── Keystatic en producción (modo GitHub) ────────────────────────────────
# El admin vive en /keystatic. En local escribe archivos directamente y no
# necesita nada de esto; en Vercel abre un commit en GitHub a nombre de
# Salomón y sí lo necesita.
#
# Cómo obtenerlos: entre a https://www.salomonmuriel.com/keystatic desde el
# deploy, siga el flujo «set up GitHub app» y Keystatic imprime los tres
# valores para pegar en Vercel → Settings → Environment Variables.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=

# Para CREAR la app de GitHub la primera vez. Keystatic sólo permite ese
# flujo en desarrollo, así que hay que levantar el dev server en modo
# GitHub y hacerlo desde localhost:
#
#   PUBLIC_KEYSTATIC_GITHUB=true npm run dev
#
# En la pantalla de setup, llene «Deployed App URL» con
# https://www.salomonmuriel.com o la app no va a servir en producción.
# Al terminar, Keystatic escribe los dos valores de arriba en `.env`.
# PUBLIC_KEYSTATIC_GITHUB=true

# Fuerza el modo local del CMS aunque no sea `astro dev`.
# PUBLIC_KEYSTATIC_LOCAL=true

# ── Search Console ───────────────────────────────────────────────────────
PUBLIC_GOOGLE_SITE_VERIFICATION=
